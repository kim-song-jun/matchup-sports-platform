<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/e_team" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:singleLine="true" android:textColor="#D9FFFFFF" android:textSize="11sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="예정된 일정이 없어요"
            android:textColor="#FFFFFFFF" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="응답할 일정도 없어요"
            android:textColor="#CCFFFFFF" android:textSize="11sp" />
    </LinearLayout>
    <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="6dp" android:src="@drawable/widget_divider" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/e_last" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <Button android:id="@+id/e_find" android:layout_width="wrap_content" android:layout_height="28dp" android:background="@drawable/widget_btn_secondary"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:text="매치 찾기" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
