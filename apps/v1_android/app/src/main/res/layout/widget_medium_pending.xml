<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/p_head" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/p_place_box" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_widget_pin" />
            <TextView android:id="@+id/p_place" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp"
                android:maxWidth="110dp" android:singleLine="true" android:ellipsize="end" android:textColor="#D9FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/p_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="21sp" android:textStyle="bold" />
        <FrameLayout android:id="@+id/p_ring_box" android:layout_width="46dp" android:layout_height="46dp">
            <ProgressBar android:id="@+id/p_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="46dp" android:layout_height="46dp"
                android:indeterminate="false" android:max="100" android:progressDrawable="@drawable/widget_ring_progress" />
            <TextView android:id="@+id/p_count" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
                android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal">
        <Button android:id="@+id/p_yes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_btn_primary"
            android:text="참석" android:textColor="#FF17265A" android:textSize="14sp" android:textStyle="bold" />
        <Button android:id="@+id/p_no" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/widget_btn_secondary"
            android:text="불참" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
