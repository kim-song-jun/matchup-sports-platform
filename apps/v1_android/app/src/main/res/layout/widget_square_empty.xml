<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/se_team" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true"
        android:textColor="#D9FFFFFF" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="예정된 일정이 없어요"
        android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/se_last" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
        android:textColor="#CCFFFFFF" android:textSize="11sp" />
</LinearLayout>
