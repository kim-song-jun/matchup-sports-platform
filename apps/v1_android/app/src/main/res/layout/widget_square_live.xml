<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/s_dot" android:layout_width="7dp" android:layout_height="7dp" android:src="@drawable/widget_dot_live" />
        <TextView android:id="@+id/s_head" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
            android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" />
        <Chronometer android:id="@+id/s_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/s_logo1" android:layout_width="24dp" android:layout_height="24dp" />
            <TextView android:id="@+id/s_name1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1"
                android:ellipsize="end" android:maxLines="2" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/s_score1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="26sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/s_logo2" android:layout_width="24dp" android:layout_height="24dp" />
            <TextView android:id="@+id/s_name2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1"
                android:ellipsize="end" android:maxLines="2" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/s_score2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="26sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/s_belt" android:layout_width="match_parent" android:layout_height="22dp" android:background="@drawable/widget_belt_bg">
        <ViewFlipper android:id="@+id/s_flip" android:layout_width="match_parent" android:layout_height="match_parent"
            android:autoStart="true" android:flipInterval="2600" android:inAnimation="@anim/widget_belt_in" android:outAnimation="@anim/widget_belt_out" />
    </FrameLayout>
</LinearLayout>
