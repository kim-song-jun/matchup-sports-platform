/**
 * 어드민이 런타임에 편집하는 외부 연동 키 저장소(싱글턴 row, id="singleton").
 * 카카오맵 REST/JS 키 우선순위: DB(이 테이블) > 환경변수(KAKAO_REST_API_KEY /
 * NEXT_PUBLIC_KAKAO_MAPS_JS_KEY) > 없음(기능 graceful-disable, WebPushService와
 * 동일 패턴). REST 키는 서버 전용(지오코딩), JS 키는 공개 엔드포인트로 노출되어
 * 지도 SDK 로드에 사용된다 — 카카오맵 JS 키는 도메인 제한으로 보호되므로 공개돼도 안전하다.
 */
model V1IntegrationSettings {
  id                   String   @id @default("singleton")
  kakaoRestApiKey      String?  @map("kakao_rest_api_key")
  kakaoMapsJsKey       String?  @map("kakao_maps_js_key")
  // 감사 추적용 참조 문자열 — FK 관계는 두지 않는다(설정 히스토리가 아니라 최신 편집자만 기록).
  updatedByAdminUserId String?  @map("updated_by_admin_user_id")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("v1_integration_settings")
}

/// 리뷰(경기 후기) 작성 가능 기간 정책. 어드민이 런타임에 바꾼다.
/// 마감을 저장해 두지 않고 매 요청 시점에 계산하므로(review-deadline.ts), 여기를 늘리면
/// 직전 정책으로는 마감됐던 경기도 다시 열리고, 줄이면 열려 있던 경기가 즉시 닫힌다.
model V1ReviewPolicySettings {
  id                   String   @id @default("singleton")
  /// 공식 결과 확정 시각(앵커)부터 후기를 쓸 수 있는 시간(시간 단위). 기본 168시간(7일).
  reviewWindowHours    Int      @default(168) @map("review_window_hours")
  // 감사 추적용 참조 문자열 — FK 관계는 두지 않는다(V1IntegrationSettings와 같은 규칙).
  updatedByAdminUserId String?  @map("updated_by_admin_user_id")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("v1_review_policy_settings")
}

model V1Game {
  id                         String                      @id @default(uuid())
  sourceType                 V1GameSourceType            @map("source_type")
  teamMatchId                String?                     @unique @map("team_match_id")
  tournamentFixtureId        String?                     @unique @map("tournament_fixture_id")
  state                      V1GameState                 @default(SCHEDULED)
  version                    Int                         @default(0)
  lastSequence               Int                         @default(0) @map("last_sequence")
  currentOfficialRevisionId  String?                     @map("current_official_revision_id")
  competitionConfigVersionId String                      @map("competition_config_version_id")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  teamMatch                  V1TeamMatch?                @relation("V1GameTeamMatch", fields: [teamMatchId], references: [id], onDelete: Restrict)
  tournamentFixture          V1TournamentFixture?        @relation("V1GameTournamentFixture", fields: [tournamentFixtureId], references: [id], onDelete: Restrict)
  currentOfficialRevision    V1GameResultRevision?       @relation("V1CurrentOfficialRevision", fields: [id, currentOfficialRevisionId], references: [gameId, id], onDelete: Restrict, map: "v1_games_current_revision_fk")
  sides                      V1GameSide[]
  periods                    V1GamePeriod[]
  lineups                    V1GameLineup[]
  // R1 expand: 역참조 배열 한 줄. v1_games 의 컬럼·제약·인덱스는 바뀌지 않는다.
  tacticsBoards              V1TeamTacticsBoard[]        @relation("V1TeamTacticsBoardGame")
  participants               V1GameParticipant[]
  events                     V1GameEvent[]
  resultRevisions            V1GameResultRevision[]      @relation("V1GameResultRevisions")
  visibilityPolicy           V1GameVisibilityPolicy?
  officialResultCaches       V1GameOfficialResultCache[]
  competitionConfig          V1CompetitionConfigVersion  @relation("V1GameCompetitionConfig", fields: [competitionConfigVersionId], references: [id], onDelete: Restrict, map: "v1_games_competition_config_fk")

  @@unique([id, currentOfficialRevisionId], map: "v1_games_id_current_official_revision_key")
  @@index([state, updatedAt])
  @@index([sourceType, createdAt])
  @@map("v1_games")
}

model V1GameSide {
  id                  String        @id @default(uuid())
  gameId              String        @map("game_id")
  sideKey             V1GameSideKey @map("side_key")
  teamId              String?       @map("team_id")
  displayNameSnapshot String        @map("display_name_snapshot")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  game                V1Game        @relation(fields: [gameId], references: [id], onDelete: Cascade, map: "v1_game_sides_game_fk")
  // R1 expand: 역참조 한 줄. v1_game_sides 의 컬럼·제약·인덱스는 바뀌지 않는다.
  tacticsBoard        V1TeamTacticsBoard? @relation("V1TeamTacticsBoardSide")

  @@unique([gameId, sideKey], map: "v1_game_sides_game_id_side_key_key")
  @@index([teamId], map: "v1_game_sides_team_id_idx")
  @@map("v1_game_sides")
}

model V1GamePeriod {
  id        String            @id @default(uuid())
  gameId    String            @map("game_id")
  number    Int
  state     V1GamePeriodState @default(SCHEDULED)
  startedAt DateTime?         @map("started_at")
  endedAt   DateTime?         @map("ended_at")
  /// Pause-aware clock (경과 시간 일시정지 반영, 2026-08): cumulative milliseconds
  /// this period has spent PAUSED across every completed pause/resume cycle so
  /// far. `resume` folds the just-closed segment in here (increment, never
  /// overwrite) so repeated pause/resume within one period accumulates
  /// correctly instead of only remembering the most recent pause.
  pausedTotalMs Int           @default(0) @map("paused_total_ms")
  /// Start of the CURRENTLY OPEN pause segment, or null when not paused right
  /// now. `pause` sets this; `resume` (and `end` while paused) folds
  /// `now - pausedAt` into `pausedTotalMs` and clears it back to null — so at
  /// most one of "currently paused" (`pausedAt` set) or "between pauses"
  /// (`pausedAt` null) is ever true, never both partially.
  pausedAt  DateTime?         @map("paused_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  game      V1Game            @relation(fields: [gameId], references: [id], onDelete: Cascade, map: "v1_game_periods_game_fk")

  @@unique([gameId, number], map: "v1_game_periods_game_id_number_key")
  @@index([gameId, state], map: "v1_game_periods_game_id_state_idx")
  @@map("v1_game_periods")
}

model V1GameLineup {
  id           String            @id @default(uuid())
  gameId       String            @map("game_id")
  sideId       String            @map("side_id")
  revision     Int
  state        V1GameLineupState @default(DRAFT)
  version      Int               @default(0)
  submittedAt  DateTime?         @map("submitted_at")
  supersedesId String?           @map("supersedes_id")
  /// 포메이션 프리셋 라벨(예: "4-4-2"). null이면 자유 배치. 실제 좌표는
  /// V1GameParticipant.positionX/Y에 저장되고 이 값은 프리셋 선택 UI 복원용 힌트일 뿐이다.
  formation    String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  game         V1Game            @relation(fields: [gameId], references: [id], onDelete: Cascade, map: "v1_game_lineups_game_fk")

  @@unique([gameId, sideId, revision], map: "v1_game_lineups_game_id_side_id_revision_key")
  @@index([gameId, sideId, state], map: "v1_game_lineups_game_id_side_id_state_idx")
  @@map("v1_game_lineups")
}

model V1GameParticipant {
  id                  String   @id @default(uuid())
  gameId              String   @map("game_id")
  sideId              String   @map("side_id")
  lineupId            String   @map("lineup_id")
  /// 이 참가자가 가리키는 실제 사용자. 대회 경기 라인업은 **참가 등록 명단
  /// (V1TournamentPlayer)이 유일한 출처**라, 화면을 다시 열 때 저장된 라인업과 등록
  /// 명단을 정확히 대조할 수 있어야 한다 — 이름 문자열만으로는 동명이인을 구분할 수
  /// 없어 선발 표시가 엉뚱한 사람에게 붙는다. FK 대신 nullable 컬럼인 이유: ① 이
  /// 컬럼이 없던 시절 저장된 라인업과 ② 사용자 계정과 무관한 team-match 경로가 함께
  /// 살아 있어야 하기 때문이다(그쪽은 이 컬럼을 쓰지 않는다).
  ///
  /// 이 값이 실려 저장되면 같은 트랜잭션에서 신원 연결(identity link, action
  /// ROSTER_ASSERTED)도 자동 생성된다(GamesService.saveLineup) — 개인 기록 공개의
  /// 출발점이다. 연결은 participant 생성만으로는 만들어지지 않으므로 여전히 옵셔널이다.
  userId              String?  @map("user_id")
  displayNameSnapshot String   @map("display_name_snapshot")
  jerseyNumber        Int?     @map("jersey_number")
  position            String?
  /// 피치 위 배치 좌표, 0~100 퍼센트(자기 진영 기준: y=0 골라인, y=100 하프라인).
  /// 둘 다 있거나 둘 다 없어야 한다(서비스 계층에서 검증) — 좌표 없이 배치만 표시하는
  /// 화면은 없으므로 부분 좌표를 허용하면 렌더링이 조용히 깨진다.
  positionX           Float?   @map("position_x")
  positionY           Float?   @map("position_y")
  /// **항상 true 다.** 선발/후보 구분은 없다 — 명단에 있으면 그 경기에 뛴 것이다
  /// (정본 docs/design/competition-canonical-flow.md §3, 2026-09-02 사용자 확정).
  /// 컬럼을 남긴 이유는 읽는 자리가 많아서지 값이 갈려서가 아니다.
  ///
  /// 이력: 예전엔 후보 표시가 경로마다 달랐다 — 대회 경기 라인업은 이 컬럼에 false 를
  /// 썼고, team-match 전용 서비스(team-match-lineup.service.ts)는 이 컬럼 대신
  /// position='BENCH' 문자열 관례를 썼다. 그래서 한 컬럼(position)이 소스에 따라 실제
  /// 포지션과 선발 여부라는 다른 뜻을 갖고, 읽는 쪽마다 소스별 분기가 복제됐다(그중
  /// 하나는 상수를 import 하지 않고 값을 복사해 갖고 있어서 이름으로 grep 해도 안 잡혔다).
  /// 마이그레이션 20260902000000_v1_lineup_bench_to_started 가 두 모양을 함께 정리했다 —
  /// **센티널도 false 도 되살리지 말 것.**
  ///
  /// 전술보드(V1TeamTacticsBoard)는 **팀 내부 도구**이고 대회·경기 진행과 연결이 없다.
  /// 그쪽 엔트리에도 같은 이름의 started 가 있지만 별개다(정본 §3 표).
  started             Boolean  @default(true) @map("started")
  /// 명단 검인(체크인) — 이 선수가 실제로 경기장에 도착한 것을 확인한 시각.
  /// 1차 대회(2026-08-15~16) 회고: "명단 검인 과정에서 오지 않거나, 하지 않은
  /// 사람들에 대한 확인이 어려움". 지금까지 스태프는 육안·구두로만 확인해야 했다.
  ///
  /// `started`(선발/후보)와 **다른 축**이다 — started 는 팀이 제출한 계획이고
  /// 이 값은 현장에서 확인한 사실이다. 선발로 제출됐지만 안 온 사람이 정확히
  /// 회고가 말한 그 사람이라, 둘을 한 컬럼으로 합치면 그 상태를 표현할 수 없다.
  ///
  /// nullable = "아직 확인 안 함". false 를 쓰지 않는 이유: 체크인은 경기 직전에
  /// 순차적으로 일어나므로 "안 왔다"와 "아직 확인 전"이 구분돼야 하고, 확인 시각
  /// 자체가 분쟁 시 근거가 된다. 체크를 되돌리면 다시 NULL 로 돌아간다.
  arrivedAt           DateTime? @map("arrived_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  game                V1Game   @relation(fields: [gameId], references: [id], onDelete: Restrict, map: "v1_game_participants_game_fk")

  @@index([gameId, sideId], map: "v1_game_participants_game_id_side_id_idx")
  @@map("v1_game_participants")
}

