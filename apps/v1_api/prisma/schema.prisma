model V1TournamentFixtureAdvancementEdge {
  id              String                      @id @default(uuid())
  tournamentId    String                      @map("tournament_id")
  sourceFixtureId String                      @map("source_fixture_id")
  sourceOutcome   V1FixtureAdvancementOutcome @map("source_outcome")
  targetFixtureId String                      @map("target_fixture_id")
  targetSide      V1FixtureTargetSide         @map("target_side")
  createdAt       DateTime                    @default(now()) @map("created_at")

  tournament    V1Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade, map: "v1_fixture_advancement_tournament_fk")
  sourceFixture V1TournamentFixture @relation("V1FixtureAdvancementSource", fields: [tournamentId, sourceFixtureId], references: [tournamentId, id], onDelete: Cascade, map: "v1_fixture_advancement_source_fk")
  targetFixture V1TournamentFixture @relation("V1FixtureAdvancementTarget", fields: [tournamentId, targetFixtureId], references: [tournamentId, id], onDelete: Cascade, map: "v1_fixture_advancement_target_fk")

  @@unique([sourceFixtureId, sourceOutcome], map: "v1_fixture_advancement_source_outcome_key")
  @@unique([targetFixtureId, targetSide], map: "v1_fixture_advancement_target_side_key")
  @@index([tournamentId, sourceFixtureId], map: "v1_fixture_advancement_source_lock_idx")
  @@index([tournamentId, targetFixtureId], map: "v1_fixture_advancement_target_lock_idx")
  @@map("v1_tournament_fixture_advancement_edges")
