  postEventTeamReviewsReceived V1PostEventReview[]        @relation("V1PostEventReviewTargetTeam")
  tournamentRegistrations      V1TournamentRegistration[]
  tournamentReviews            V1TournamentReview[]       @relation("V1TournamentReviewTeam")
  leaguePromotions             V1LeaguePromotion[]         @relation("V1LeaguePromotionTeam")
  lineupPresets                V1TeamLineupPreset[]
