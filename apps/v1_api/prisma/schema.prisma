  attendance       V1ScheduleAttendance[]
  guestRecruitment V1ScheduleGuestRecruitment?

  @@unique([teamId, teamMatchId], map: "v1_team_schedules_team_match_unique")
  @@index([teamId, startAt], map: "v1_team_schedules_team_start_idx")
  @@index([teamMatchId], map: "v1_team_schedules_team_match_idx")
  @@map("v1_team_schedules")
}

model V1ScheduleAttendance {
  id               String             @id @default(uuid())
  scheduleId       String             @map("schedule_id")
  userId           String             @map("user_id")
  status           V1AttendanceStatus
  waitlistPosition Int?               @map("waitlist_position")
  version          Int                @default(0)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  schedule         V1TeamSchedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade, map: "v1_schedule_attendance_schedule_fk")

  @@unique([scheduleId, userId], map: "v1_schedule_attendance_schedule_user_key")
  @@map("v1_schedule_attendance")
}

model V1ScheduleGuestRecruitment {
  id           String                       @id @default(uuid())
  scheduleId   String                       @unique @map("schedule_id")
  slots        Int
  closesAt     DateTime                     @map("closes_at")
  note         String?
  visibility   V1GuestRecruitmentVisibility @default(MEMBERS)
  state        V1GuestRecruitmentState      @default(OPEN)
  version      Int                          @default(0)
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")
  schedule     V1TeamSchedule               @relation(fields: [scheduleId], references: [id], onDelete: Cascade, map: "v1_guest_recruitment_schedule_fk")
  applications V1ScheduleGuestApplication[]

  @@map("v1_schedule_guest_recruitments")
}

model V1ScheduleGuestApplication {
  id                  String                     @id @default(uuid())
  recruitmentId       String                     @map("recruitment_id")
  userId              String                     @map("user_id")
  displayNameSnapshot String                     @map("display_name_snapshot")
  note                String?
  state               V1GuestApplicationState    @default(PENDING)
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  recruitment         V1ScheduleGuestRecruitment @relation(fields: [recruitmentId], references: [id], onDelete: Cascade, map: "v1_guest_application_recruitment_fk")

  @@unique([recruitmentId, userId], map: "v1_schedule_guest_applications_recruitment_user_key")
  @@map("v1_schedule_guest_applications")
}

model V1TournamentField {
  id               String                        @id @default(uuid())
  tournamentId     String                        @map("tournament_id")
  scopeKey         String                        @map("scope_key")
  name             String
  sortOrder        Int                           @default(0) @map("sort_order")
  active           Boolean                       @default(true)
  version          Int                           @default(0)
  createdAt        DateTime                      @default(now()) @map("created_at")
  updatedAt        DateTime                      @updatedAt @map("updated_at")
  tournament       V1Tournament                  @relation(fields: [tournamentId], references: [id], onDelete: Cascade, map: "v1_tournament_fields_tournament_fk")
  staffAssignments V1TournamentStaffAssignment[]
  fixtures         V1TournamentFixture[]
  operationAudits  V1OperationAudit[]

  @@unique([tournamentId, scopeKey], map: "v1_tournament_fields_tournament_scope_key")
  @@unique([tournamentId, id], map: "v1_tournament_fields_tournament_id_id_key")
  @@map("v1_tournament_fields")
}

model V1TournamentStaffAssignment {
  id              String                          @id @default(uuid())
  tournamentId    String                          @map("tournament_id")
  userId          String                          @map("user_id")
  role            V1TournamentStaffRole
  fieldId         String?                         @map("field_id")
  version         Int                             @default(0)
  expiresAt       DateTime?                       @map("expires_at")
  revokedAt       DateTime?                       @map("revoked_at")
  grantedByUserId String                          @map("granted_by_user_id")
  createdAt       DateTime                        @default(now()) @map("created_at")
  updatedAt       DateTime                        @updatedAt @map("updated_at")
  tournament      V1Tournament                    @relation(fields: [tournamentId], references: [id], onDelete: Cascade, map: "v1_tournament_staff_assignments_tournament_fk")
  user            V1User                          @relation("V1TournamentStaffUser", fields: [userId], references: [id], onDelete: Restrict, map: "v1_tournament_staff_assignments_user_fk")
  grantedBy       V1User                          @relation("V1TournamentStaffGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict, map: "v1_tournament_staff_assignments_grantor_fk")
  field           V1TournamentField?              @relation(fields: [tournamentId, fieldId], references: [tournamentId, id], onDelete: Restrict, map: "v1_staff_field_fk")
  fixtureScopes   V1TournamentStaffFixtureScope[]

  @@index([userId, revokedAt, expiresAt], map: "v1_tournament_staff_assignments_user_idx")
  @@index([tournamentId, role], map: "v1_tournament_staff_assignments_tournament_role_idx")
  @@map("v1_tournament_staff_assignments")
}

model V1TournamentStaffFixtureScope {
  id           String                      @id @default(uuid())
  assignmentId String                      @map("assignment_id")
  fixtureId    String                      @map("fixture_id")
  createdAt    DateTime                    @default(now()) @map("created_at")
  assignment   V1TournamentStaffAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, map: "v1_staff_scope_assignment_fk")
  fixture      V1TournamentFixture         @relation(fields: [fixtureId], references: [id], onDelete: Restrict, map: "v1_staff_scope_fixture_fk")

  @@unique([assignmentId, fixtureId], map: "v1_tournament_staff_fixture_scopes_assignment_fixture_key")
  @@map("v1_tournament_staff_fixture_scopes")
}

model V1CompetitionConfigVersion {
  id              String                    @id @default(uuid())
  sportCode       String                    @map("sport_code")
  name            String
  version         Int
  status          V1CompetitionConfigStatus @default(ACTIVE)
  periods         Json
  events          Json
  lineup          Json
  result          Json
  tieBreak        Json                      @map("tie_break")
  visibility      Json
  contentHash     String                    @unique @map("content_hash")
  createdByUserId String?                   @map("created_by_user_id")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  games           V1Game[]                  @relation("V1GameCompetitionConfig")
  teamMatches     V1TeamMatch[]             @relation("V1TeamMatchCompetitionConfig")
  tournaments     V1Tournament[]            @relation("V1TournamentCompetitionConfig")
  fixtures        V1TournamentFixture[]     @relation("V1FixtureCompetitionConfig")

  @@unique([sportCode, name, version])
  @@map("v1_competition_config_versions")
}

model V1ResultEscalation {
  id               String               @id @default(uuid())
  resultRevisionId String               @map("result_revision_id")
  kind             V1EscalationKind
  dueAt            DateTime             @map("due_at")
  status           V1EscalationStatus   @default(PENDING)
  ackByUserId      String?              @map("ack_by_user_id")
  resolvedByUserId String?              @map("resolved_by_user_id")
  reason           String?
  version          Int                  @default(0)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  resultRevision   V1GameResultRevision @relation(fields: [resultRevisionId], references: [id], onDelete: Restrict, map: "v1_result_escalations_revision_fk")
  acknowledgedBy   V1User?              @relation("V1EscalationAcknowledgedBy", fields: [ackByUserId], references: [id], onDelete: Restrict, map: "v1_result_escalations_ack_user_fk")
  resolvedBy       V1User?              @relation("V1EscalationResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict, map: "v1_result_escalations_resolved_user_fk")

  @@unique([resultRevisionId, kind], map: "v1_result_escalations_revision_kind_key")
  @@index([status, dueAt], map: "v1_result_escalations_status_due_idx")
  @@map("v1_result_escalations")
}

model V1GameOperationFlag {
  id              String                 @id @default(uuid())
  key             V1GameOperationFlagKey @unique
  value           String
  version         Int                    @default(0)
  ownerActor      String                 @map("owner_actor")
  updatedByUserId String?                @map("updated_by_user_id")
  rollbackValue   String?                @map("rollback_value")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  createdAt       DateTime               @default(now()) @map("created_at")

  @@map("v1_game_operation_flags")
}

model V1GameOperationGateSetting {
  id                    String   @id @default("singleton")
  simplifiedGateEnabled Boolean  @default(false) @map("simplified_gate_enabled")
  version               Int      @default(0)
  updatedByUserId       String?  @map("updated_by_user_id")
  updatedAt             DateTime @updatedAt @map("updated_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("v1_game_operation_gate_settings")
}

model V1GameCutoverEpoch {
  id                      String          @id @default("game-cutover")
  version                 Int             @default(0)
  writeMode               V1GameWriteMode @default(legacy) @map("write_mode")
  firstNewWriteAt         DateTime?       @map("first_new_write_at")
  firstNewWriteResourceId String?         @map("first_new_write_resource_id")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  @@map("v1_game_cutover_epochs")
}

model V1OperationAudit {
  id             String               @id @default(uuid())
  actorType      V1OperationActorType @map("actor_type")
  actorUserId    String?              @map("actor_user_id")
  systemActor    String?              @map("system_actor")
  action         String
  resourceType   String               @map("resource_type")
  resourceId     String               @map("resource_id")
  requestId      String               @map("request_id")
  maskedSourceIp String?              @map("source_ip")
  before         Json?
  after          Json?
  reason         String?
  tournamentId   String?              @map("tournament_id")
  fixtureId      String?              @map("fixture_id")
  fieldId        String?              @map("field_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  tournament     V1Tournament?        @relation(fields: [tournamentId], references: [id], onDelete: Restrict, map: "v1_operation_audits_tournament_fk")
  fixture        V1TournamentFixture? @relation(fields: [tournamentId, fixtureId], references: [tournamentId, id], onDelete: Restrict, map: "v1_operation_audits_fixture_fk")
  field          V1TournamentField?   @relation(fields: [tournamentId, fieldId], references: [tournamentId, id], onDelete: Restrict, map: "v1_operation_audits_field_fk")

  @@index([resourceType, resourceId, createdAt], map: "v1_operation_audits_resource_idx")
  @@index([actorUserId, createdAt], map: "v1_operation_audits_actor_idx")
  @@index([requestId], map: "v1_operation_audits_request_idx")
  @@index([tournamentId, createdAt], map: "v1_operation_audits_tournament_idx")
  @@index([fixtureId, createdAt], map: "v1_operation_audits_fixture_idx")
  @@index([fieldId, createdAt], map: "v1_operation_audits_field_idx")
  @@map("v1_operation_audits")
}
