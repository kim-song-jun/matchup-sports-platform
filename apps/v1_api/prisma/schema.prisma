  resultRevision   V1GameResultRevision @relation(fields: [resultRevisionId], references: [id], onDelete: Restrict, map: "v1_result_escalations_revision_fk")
  acknowledgedBy   V1User?              @relation("V1EscalationAcknowledgedBy", fields: [ackByUserId], references: [id], onDelete: Restrict, map: "v1_result_escalations_ack_user_fk")
  resolvedBy       V1User?              @relation("V1EscalationResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict, map: "v1_result_escalations_resolved_user_fk")

  @@unique([resultRevisionId, kind], map: "v1_result_escalations_revision_kind_key")
  @@index([status, dueAt], map: "v1_result_escalations_status_due_idx")
  @@map("v1_result_escalations")
}

model V1GameOperationFlag {
  id              String                 @id @default(uuid())
  key             V1GameOperationFlagKey @unique
  value           String
  version         Int                    @default(0)
  ownerActor      String                 @map("owner_actor")
  updatedByUserId String?                @map("updated_by_user_id")
  rollbackValue   String?                @map("rollback_value")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  createdAt       DateTime               @default(now()) @map("created_at")

  @@map("v1_game_operation_flags")
}

model V1GameOperationGateSetting {
  id                    String   @id @default("singleton")
  simplifiedGateEnabled Boolean  @default(false) @map("simplified_gate_enabled")
  version               Int      @default(0)
  updatedByUserId       String?  @map("updated_by_user_id")
  updatedAt             DateTime @updatedAt @map("updated_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("v1_game_operation_gate_settings")
}

model V1GameCutoverEpoch {
  id                      String          @id @default("game-cutover")
  version                 Int             @default(0)
  writeMode               V1GameWriteMode @default(legacy) @map("write_mode")
  firstNewWriteAt         DateTime?       @map("first_new_write_at")
  firstNewWriteResourceId String?         @map("first_new_write_resource_id")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  @@map("v1_game_cutover_epochs")
}

model V1OperationAudit {
  id             String               @id @default(uuid())
  actorType      V1OperationActorType @map("actor_type")
  actorUserId    String?              @map("actor_user_id")
  systemActor    String?              @map("system_actor")
  action         String
  resourceType   String               @map("resource_type")
  resourceId     String               @map("resource_id")
  requestId      String               @map("request_id")
  maskedSourceIp String?              @map("source_ip")
  before         Json?
  after          Json?
  reason         String?
  tournamentId   String?              @map("tournament_id")
  fixtureId      String?              @map("fixture_id")
  fieldId        String?              @map("field_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  tournament     V1Tournament?        @relation(fields: [tournamentId], references: [id], onDelete: Restrict, map: "v1_operation_audits_tournament_fk")
  fixture        V1TournamentFixture? @relation(fields: [tournamentId, fixtureId], references: [tournamentId, id], onDelete: Restrict, map: "v1_operation_audits_fixture_fk")
  field          V1TournamentField?   @relation(fields: [tournamentId, fieldId], references: [tournamentId, id], onDelete: Restrict, map: "v1_operation_audits_field_fk")

  @@index([resourceType, resourceId, createdAt], map: "v1_operation_audits_resource_idx")
  @@index([actorUserId, createdAt], map: "v1_operation_audits_actor_idx")
  @@index([requestId], map: "v1_operation_audits_request_idx")
  @@index([tournamentId, createdAt], map: "v1_operation_audits_tournament_idx")
  @@index([fixtureId, createdAt], map: "v1_operation_audits_fixture_idx")
  @@index([fieldId, createdAt], map: "v1_operation_audits_field_idx")
  @@map("v1_operation_audits")
}
