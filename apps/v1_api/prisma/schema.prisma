model V1UserSportPreference {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  sportId      String   @map("sport_id")
  sportLevelId String?  @map("sport_level_id")
  isPrimary    Boolean  @default(false) @map("is_primary")
  /// 이 종목에서 **주로 서는 자리**. 값은 그 종목 대회 설정의 `lineup.positions[].code`
  /// 다(축구 `GK`/`DF`/`MF`/`FW`, 풋살 `GOLEIRO`/`FIXO`/`ALA`/`PIVO`) — 종목마다 코드가
  /// 다르므로 하드코딩하지 않고 **프리셋을 단일 출처**로 쓴다.
  ///
  /// 사람 축에 두는 이유: 사용자가 **한 번 정하면 모든 대회·리그에 자동 적용**되는 값이다
  /// (D14). 대회 참가 명단(`V1TournamentPlayer`)에 두면 대회마다 다시 입력이 된다.
  ///
  /// nullable = 미설정. 강제하지 않는다 — 안 고르면 선수 카드 포지션이 '미상'이고
  /// 능력치 가중치는 균등이다. 그것이 정상 상태이지 결함이 아니다.
  preferredPosition          String?  @map("preferred_position")
  /// 부(副) 포지션. **주가 없으면 부만 있을 수 없고**(무의미하다), **주와 같을 수 없다**
  /// (같으면 정보가 0이다) — 서비스 계층에서 검증한다.
  ///
  /// **선수 카드 계산에는 쓰지 않는다.** 가중치는 주 포지션 기준이다 — 둘을 섞으면
  /// 가중치의 의미가 흐려진다. 이 값의 용도는 표시다("주 ALA / 부 PIVO").
  secondaryPreferredPosition String?  @map("secondary_preferred_position")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       V1User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport      V1Sport       @relation(fields: [sportId], references: [id], onDelete: Restrict)
  sportLevel V1SportLevel? @relation(fields: [sportLevelId], references: [id], onDelete: SetNull)

  @@unique([userId, sportId])
  @@index([sportId])
  @@index([sportLevelId])
  @@map("v1_user_sport_preferences")
}

model V1UserRegion {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  regionId  String   @map("region_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   V1User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  region V1Region @relation(fields: [regionId], references: [id], onDelete: Restrict)

  @@unique([userId, regionId])
  @@index([regionId])
  @@map("v1_user_regions")
}

model V1UserReputationSummary {
  id          String       @id @default(uuid())
  userId      String       @unique @map("user_id")
  trustState  V1TrustState @default(sample) @map("trust_state")
  mannerScore Decimal?     @map("manner_score") @db.Decimal(4, 2)
  reviewCount Int          @default(0) @map("review_count")
  sourceLabel String?      @map("source_label")
  // 대회 개인 후기(sourceType=tournament_fixture · targetType=user) 전용 집계.
  // V1TeamTrustScore의 tournament* 컬럼 분리와 같은 이유로 개인 매치(match) 후기와 컬럼을 나눈다 —
  // 대회는 한 번 나가면 상대팀 로스터 전원에게 며칠 만에 수십 건을 받을 수 있어서, 같은 컬럼에 합산하면
  // 개인 매치로 쌓아온 평점이 대회 한 번에 통째로 덮인다. 두 recalculate 경로가 서로 다른 모집단을
  // 계산하면서 같은 컬럼을 last-write-wins로 덮어쓰는 문제도 함께 막는다.
  tournamentTrustState  V1TrustState @default(sample) @map("tournament_trust_state")
  tournamentMannerScore Decimal?     @map("tournament_manner_score") @db.Decimal(4, 2)
  // 후기 "건수"가 아니라 "평가한 상대팀 수"다(V1TeamTrustScore.tournamentReviewCount와 같은 의미) —
  // recalculateTournamentUserReputation()이 (대회 × 평가한 팀) 단위로 접은 뒤 그 수를 넣는다.
  tournamentReviewCount Int          @default(0) @map("tournament_review_count")
  tournamentSourceLabel String?      @map("tournament_source_label")
  // calculatedAt은 두 경로가 공유한다(V1TeamTrustScore와 동일) — 값이 아니라 "마지막 재계산 시각"이라 소스별로 나눌 필요가 없다.
  // 4항목 개별 채점(V1PostEventReviewMetricScore) 평균. 기존 mannerScore(종합 rating 기반)와
  // metricMannerScore(MANNER 항목 단독 평균)는 이름이 비슷하지만 **다른 컬럼**이다 — 합치지 않는다.
  metricSkillScore       Decimal? @map("metric_skill_score") @db.Decimal(4, 2)
  metricPunctualityScore Decimal? @map("metric_punctuality_score") @db.Decimal(4, 2)
  metricSafetyScore      Decimal? @map("metric_safety_score") @db.Decimal(4, 2)
  metricMannerScore      Decimal? @map("metric_manner_score") @db.Decimal(4, 2)
  metricReviewCount      Int      @default(0) @map("metric_review_count")
  // 대회(tournament_fixture) 전용 분리 — 위 tournament* 컬럼들과 같은 이유다.
  tournamentMetricSkillScore       Decimal? @map("tournament_metric_skill_score") @db.Decimal(4, 2)
  tournamentMetricPunctualityScore Decimal? @map("tournament_metric_punctuality_score") @db.Decimal(4, 2)
  tournamentMetricSafetyScore      Decimal? @map("tournament_metric_safety_score") @db.Decimal(4, 2)
  tournamentMetricMannerScore      Decimal? @map("tournament_metric_manner_score") @db.Decimal(4, 2)
  tournamentMetricReviewCount      Int      @default(0) @map("tournament_metric_review_count")
  calculatedAt DateTime? @map("calculated_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user V1User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([trustState])
  @@map("v1_user_reputation_summaries")
}

