  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("v1_runtime_checks")
}

model V1User {
  id               String             @id @default(uuid())
  email            String?            @unique
  phone            String?            @unique
  accountStatus    V1AccountStatus    @default(active) @map("account_status")
  onboardingStatus V1OnboardingStatus @default(not_started) @map("onboarding_status")
  lastLoginAt      DateTime?          @map("last_login_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")
  emailVerifiedAt  DateTime?          @map("email_verified_at")
  phoneVerifiedAt  DateTime?          @map("phone_verified_at")
  themePreference  V1ThemePreference  @default(light) @map("theme_preference")

  authIdentities                 V1AuthIdentity[]
  profile                        V1UserProfile?
  onboardingProgress             V1UserOnboardingProgress?
  termsConsents                  V1UserTermsConsent[]
  sportPreferences               V1UserSportPreference[]
  regions                        V1UserRegion[]
  reputationSummary              V1UserReputationSummary?
  hostedMatches                  V1Match[]                     @relation("V1MatchHost")
  matchApplications              V1MatchApplication[]          @relation("V1MatchApplicant")
  reviewedApplications           V1MatchApplication[]          @relation("V1MatchApplicationReviewer")
  matchParticipants              V1MatchParticipant[]
  ownedTeams                     V1Team[]                      @relation("V1TeamOwner")
  teamMemberships                V1TeamMembership[]            @relation("V1TeamMember")
  removedTeamMemberships         V1TeamMembership[]            @relation("V1TeamMembershipRemover")
  teamJoinApplications           V1TeamJoinApplication[]       @relation("V1TeamJoinApplicant")
  reviewedTeamJoins              V1TeamJoinApplication[]       @relation("V1TeamJoinReviewer")
  teamInvitesReceived            V1TeamInvitation[]            @relation("V1TeamInvitee")
  teamInvitesSent                V1TeamInvitation[]            @relation("V1TeamInviter")
  createdTeamMatches             V1TeamMatch[]                 @relation("V1TeamMatchCreator")
  teamMatchApplications          V1TeamMatchApplication[]      @relation("V1TeamMatchApplicantUser")
  reviewedTeamMatches            V1TeamMatchApplication[]      @relation("V1TeamMatchReviewer")
  chatParticipations             V1ChatRoomParticipant[]
  chatMessages                   V1ChatMessage[]               @relation("V1ChatMessageSender")
  notifications                  V1Notification[]
  notificationPreference         V1NotificationPreference?
  pushSubscriptions              V1PushSubscription[]
  pushDevices                    V1PushDevice[]
  webPushFailureLogs             V1WebPushFailureLog[]         @relation("V1WebPushFailureLogUser")
  acknowledgedPushFailureLogs    V1WebPushFailureLog[]         @relation("V1WebPushFailureLogAcknowledgedBy")
  searchHistories                V1SearchHistory[]
  adminUser                      V1AdminUser?                  @relation("V1AdminUserAccount")
  grantedAdmins                  V1AdminUser[]                 @relation("V1AdminGrantor")
  statusLogs                     V1StatusChangeLog[]           @relation("V1StatusActorUser")
  postEventReviewsWritten        V1PostEventReview[]           @relation("V1PostEventReviewReviewer")
  postEventUserReviewsReceived   V1PostEventReview[]           @relation("V1PostEventReviewTargetUser")
  tournamentRegistrationsApplied V1TournamentRegistration[]    @relation("V1TournamentRegistrationApplicant")
  tournamentPlayerEntries        V1TournamentPlayer[]
  tournamentReviews              V1TournamentReview[]          @relation("V1TournamentReviewAuthor")
  tournamentAwardsReceived       V1TournamentAward[]           @relation("V1TournamentAwardRecipient")
  tournamentStaffAssignments     V1TournamentStaffAssignment[] @relation("V1TournamentStaffUser")
  grantedTournamentStaff         V1TournamentStaffAssignment[] @relation("V1TournamentStaffGrantor")
  verificationTokens             V1VerificationToken[]
  inquiries                      V1Inquiry[]
  uploadAssets                   V1UploadAsset[]
  acknowledgedResultEscalations  V1ResultEscalation[]          @relation("V1EscalationAcknowledgedBy")
  resolvedResultEscalations      V1ResultEscalation[]          @relation("V1EscalationResolvedBy")
  teamContactRequestsMade        V1TeamContact[]               @relation("V1TeamContactRequestedBy")
  teamContactRequestsResponded   V1TeamContact[]               @relation("V1TeamContactRespondedBy")
  teamContactBlocksCreated       V1TeamContactBlock[]

  @@index([accountStatus])
  @@index([onboardingStatus])
  @@index([createdAt])
  @@map("v1_users")
}

model V1UploadAsset {
  id          String       @id @default(uuid())
  ownerUserId String       @map("owner_user_id")
  kind        V1UploadKind
  mimeType    String       @map("mime_type")
  byteSize    BigInt       @map("byte_size")
  url         String       @unique
  storagePath String       @unique @map("storage_path")
  createdAt   DateTime     @default(now()) @map("created_at")

  ownerUser V1User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, kind, createdAt])
  @@map("v1_upload_assets")
}

model V1AuthIdentity {
  id              String               @id @default(uuid())
  userId          String               @map("user_id")
  provider        V1AuthProvider
  providerUserKey String               @map("provider_user_key")
  email           String?
  passwordHash    String?              @map("password_hash")
  status          V1AuthIdentityStatus @default(active)
  lastLoginAt     DateTime?            @map("last_login_at")
  unlinkedAt      DateTime?            @map("unlinked_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  user V1User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserKey])
  @@index([userId])
  @@index([status])
  @@map("v1_auth_identities")
}

enum V1VerificationChannel {
  email
  phone
}

model V1VerificationToken {
  id           String                @id @default(uuid())
  userId       String                @map("user_id")
  channel      V1VerificationChannel
  target       String
  codeHash     String                @map("code_hash")
  expiresAt    DateTime              @map("expires_at")
  consumedAt   DateTime?             @map("consumed_at")
  attemptCount Int                   @default(0) @map("attempt_count")
  createdAt    DateTime              @default(now()) @map("created_at")

  user V1User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel])
  @@map("v1_verification_tokens")
}

model V1PhoneVerificationChallenge {
  id           String    @id @default(uuid())
  phone        String    @unique
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("v1_phone_verification_challenges")
}

/**
 * 비로그인 이메일 OTP 챌린지(비밀번호 재설정). V1VerificationToken 은 userId 가 필수라
 * 가입되지 않은 주소로는 행을 만들 수 없고, 그러면 "가입 안 된 이메일"만 응답이 갈려
 * 계정 존재 여부가 새어 나간다. 그래서 휴대폰 챌린지와 같은 모양으로 따로 둔다.
 */
model V1EmailVerificationChallenge {
  id           String    @id @default(uuid())
  email        String    @unique
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("v1_email_verification_challenges")
}

model V1UserProfile {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  nickname        String
  gender          String?
  birthDate       String?   @map("birth_date")
  profileImageUrl String?   @map("profile_image_url")
  bio             String?
  visibility      String    @default("public")
  displayName     String?   @map("display_name")
  realName        String?   @map("real_name")
  displayRegion   String?   @map("display_region")
  /// 대회 경기 기록(라인업/이벤트 득점자/MVP)에 닉네임 대신 실명을 보여줄지 사용자가 직접
  /// 켜고 끄는 스위치. 기본값 false(닉네임) -- 2026-08-18 사용자 결정으로 "대회 참가자
  /// 실명은 신청 때마다 동의 없이 항상 공개"였던 이전 정책(2026-08-13)을 대체한다. 대회
  /// 신청 흐름에는 이 값을 묻는 동의 스텝이 없다 -- 한 번 켜면 이후 모든 대회 기록에
  /// 계속 적용되고, 언제든 여기서 끌 수 있다. `public-tournament-records.service.ts`가
  /// 표시 시점에 `V1GameParticipant.userId`로 이 프로필을 조인해 즉시 반영한다(자세한
  /// 배경은 그 파일의 `resolveParticipantDisplayName` 주석 참고).
  tournamentRealNameVisible Boolean @default(false) @map("tournament_real_name_visible")
  /// 선수 카드(Task 155)를 끄는 스위치. 기본값 false = 카드를 보여준다.
  /// 켜면 본인에게도 남에게도 카드가 안 보이고 기존 프로필만 남는다 -- 게임화에
  /// 거부감이 있는 사용자를 위한 탈출구다. 카드를 강제하지 않기 위해 존재한다.
  playerCardHidden Boolean @default(false) @map("player_card_hidden")
  // 선수 카드 **모양**. 코스메틱이라 능력치·등급 계산에는 쓰이지 않는다.
  // 기본값은 'rect'(네모) -- 처음 받는 카드는 가장 단순해야 하고, 방패는 업적으로 연다.
  // 잠금 조건을 못 넘은 값이 저장돼 있어도 서버가 매번 재판정해 rect 로 떨어뜨린다
  // (후기 삭제 등으로 조건이 깨졌을 때 화면과 권한이 어긋나지 않게).
  playerCardShape String @default("rect") @map("player_card_shape")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user V1User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nickname])
  @@map("v1_user_profiles")
}

model V1UserOnboardingProgress {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  currentStep String    @default("terms") @map("current_step")
  draftJson   Json?     @map("draft_json")
  completedAt DateTime? @map("completed_at")
  deferredAt  DateTime? @map("deferred_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user V1User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("v1_user_onboarding_progress")
}

model V1TermsDocument {
  id          String                @id @default(uuid())
  kind        V1TermsKind
  version     String
  title       String
  content     String
  status      V1TermsDocumentStatus @default(draft)
  isRequired  Boolean               @default(true) @map("is_required")
  publishedAt DateTime?             @map("published_at")
  archivedAt  DateTime?             @map("archived_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  consents V1UserTermsConsent[]

  @@unique([kind, version])
  @@index([status])
  @@index([createdAt])
  @@map("v1_terms_documents")
}

model V1UserTermsConsent {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  termsDocumentId String    @map("terms_document_id")
  acceptedAt      DateTime  @default(now()) @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user          V1User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsDocument V1TermsDocument @relation(fields: [termsDocumentId], references: [id], onDelete: Restrict)

  @@unique([userId, termsDocumentId])
  @@index([termsDocumentId])
  @@map("v1_user_terms_consents")
}

/// Stable identity for a managed legal/content policy. Versions live in
/// V1ManagedTermsDocument and are never overwritten after publication.
model V1ManagedTermsPolicy {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents  V1ManagedTermsDocument[]
  placements V1ManagedTermsPlacement[]

  @@index([isActive])
  @@map("v1_managed_terms_policies")
}

/// Immutable published version of a managed policy. content contains the
/// exact plain-text document shown by the current v1 UI baseline.
model V1ManagedTermsDocument {
  id                   String                @id @default(uuid())
  policyId             String                @map("policy_id")
  version              String
  title                String
  subtitle             String?               @db.Text
  content              String                @db.Text
  contentHash          String                @map("content_hash")
  changeSummary        String?               @map("change_summary") @db.Text
  requiresReconsent    Boolean               @default(true) @map("requires_reconsent")
  enforcementAt        DateTime?             @map("enforcement_at")
  status               V1TermsDocumentStatus @default(draft)
  effectiveAt          DateTime?             @map("effective_at")
  publishedAt          DateTime?             @map("published_at")
  archivedAt           DateTime?             @map("archived_at")
  supersedesDocumentId String?               @map("supersedes_document_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  policy             V1ManagedTermsPolicy         @relation(fields: [policyId], references: [id], onDelete: Restrict)
  supersedesDocument V1ManagedTermsDocument?      @relation("V1ManagedTermsDocumentHistory", fields: [supersedesDocumentId], references: [id], onDelete: Restrict)
  supersededBy       V1ManagedTermsDocument[]     @relation("V1ManagedTermsDocumentHistory")
  consentEvents      V1ManagedTermsConsentEvent[]

  @@unique([policyId, version])
  @@index([status, effectiveAt])
  @@index([status, enforcementAt])
  @@index([supersedesDocumentId])
  @@map("v1_managed_terms_documents")
}

/// Declares where a policy is shown and whether that flow treats it as
/// required, optional, or display-only.
model V1ManagedTermsPlacement {
  id           String                    @id @default(uuid())
  policyId     String                    @map("policy_id")
  context      V1ManagedTermsContext
  requirement  V1ManagedTermsRequirement
  displayOrder Int                       @default(0) @map("display_order")
  isActive     Boolean                   @default(true) @map("is_active")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  policy V1ManagedTermsPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([policyId, context])
  @@index([context, isActive, displayOrder])
  @@map("v1_managed_terms_placements")
}

/// Append-only consent history. Legacy source identifiers are stored as
/// snapshots rather than cascading foreign keys so operational deletion cannot
/// erase the audit record.
model V1ManagedTermsConsentEvent {
  id                       String                        @id @default(uuid())
  documentId               String                        @map("document_id")
  userId                   String                        @map("user_id")
  context                  V1ManagedTermsContext
  decision                 V1ManagedTermsConsentDecision
  decidedAt                DateTime?                     @map("decided_at")
  recordedAt               DateTime                      @default(now()) @map("recorded_at")
  source                   V1ManagedTermsConsentSource
  versionVerified          Boolean                       @default(true) @map("version_verified")
  legacyUserConsentId      String?                       @map("legacy_user_consent_id")
  tournamentRegistrationId String?                       @map("tournament_registration_id")
  teamId                   String?                       @map("team_id")
  legacyBooleanValue       Boolean?                      @map("legacy_boolean_value")
  dedupeKey                String?                       @unique @map("dedupe_key")
  createdAt                DateTime                      @default(now()) @map("created_at")

  document V1ManagedTermsDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([userId, context, recordedAt])
  @@index([documentId, decision])
  @@index([legacyUserConsentId])
  @@index([tournamentRegistrationId])
  @@index([teamId])
  @@map("v1_managed_terms_consent_events")
}

/// Immutable count/distribution evidence captured by a data migration.
model V1ManagedTermsMigrationAudit {
  id           String   @id @default(uuid())
  migrationKey String   @unique @map("migration_key")
  snapshot     Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("v1_managed_terms_migration_audits")
}

