// ---------------------------------------------------------------------------
// Tournament domain (Wave 2-3) — 풋살 토너먼트. 팀 단위 참가 신청 + 명단 +
// 결제(PG/계좌이체 택1) + 어드민 수동 운영(대진/결과/순위/공지).
// ---------------------------------------------------------------------------

enum V1TournamentStatus {
  draft
  open
  closed
  in_progress
  completed
  cancelled
}

enum V1TournamentCampaignStatus {
  draft
  published
  archived
}

enum V1TournamentFormat {
  league
  knockout
  group_knockout
}

// ── 대회·리그 통합 (R1 expand) ────────────────────────────────────────────────
// 정규 리그를 "대회의 한 종류"로 흡수하기 위한 축. 이 단계에서는 컬럼만 만들고
// 읽는 코드가 없다 — 테이블 rename(v1_tournaments → v1_competitions)은 R5 이후이며
// 여기서 하지 않는다. 되돌리기는 컬럼 드롭 하나로 끝나야 하기 때문이다.

/// 이 대회가 단발 대회인가, 시리즈에 묶인 정규 리그 시즌인가.
/// 기존 v1_tournaments 행은 전부 단발 대회이므로 default 가 곧 사실이다.
enum V1CompetitionKind {
  regular_tournament
  regular_league
}

/// 참가팀이 이 대회에 들어온 경로(D7·D9). applied=팀이 직접 신청,
/// promoted=직전 시즌 승강 결과로 자동 승계, seeded=운영자가 지정.
/// 어드민 참가팀 조정 화면이 이 값을 그대로 구분 표시로 쓴다.
enum V1CompetitionEntrySource {
  applied
  promoted
  seeded
}

enum V1TournamentGenderCategory {
  mixed
  male
  female
}

enum V1TournamentRegistrationStatus {
  draft
  submitted
  awaiting_payment
  payment_checking
  paid
  confirmed
  waitlisted
  cancel_requested
  cancelled
}

enum V1TournamentPaymentMethod {
  pg
  bank_transfer
}

enum V1TournamentPaymentStatus {
  ready
  paid
  failed
  cancelled
  refunded
}

enum V1TournamentPlayerEligibility {
  non_pro
  pro
  needs_review
}

enum V1TournamentGroupPhase {
  group
  semi
  final
  third_place
}

enum V1TournamentFixtureStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum V1TournamentGoalTeam {
  home
  away
}

enum V1TournamentAnnouncementAudience {
  public
  all_registered
  confirmed_only
  waitlist
}

enum V1TournamentAnnouncementCategory {
  general
  venue
  sponsor
  media
  results
  review
}

model V1Tournament {
  id                         String                      @id @default(uuid())
  sportId                    String                      @map("sport_id")
  title                      String
  status                     V1TournamentStatus          @default(draft)
  format                     V1TournamentFormat          @default(group_knockout)
  registrationDeadlineAt     DateTime?                   @map("registration_deadline_at")
  rosterDeadlineAt           DateTime?                   @map("roster_deadline_at")
  bracketPublishedAt         DateTime?                   @map("bracket_published_at")
  // 예약 공개 시각. 스케줄러 없이 조회 시점에 판정한다(now >= 이 값이면 공개로 간주하며,
  // 이때 bracketPublishedAt 은 null 로 남는다 — 공개 근거가 이 컬럼이다).
  // 즉시 공개(publishBracket)와 공개 취소(unpublishBracket)는 이 값을 null 로 비운다.
  bracketPublishScheduledAt  DateTime?                   @map("bracket_publish_scheduled_at")
  scheduledAt                DateTime?                   @map("scheduled_at")
  scheduledEndAt             DateTime?                   @map("scheduled_end_at")
  venue                      String?
  parkingInfo                String?                     @default("주차와 입장 동선은 지도에서 확인해요.") @map("parking_info")
  // 카카오 로컬 API 키워드 검색으로 venue를 지오코딩한 좌표(KakaoGeocodingService). 키 미설정/검색
  // 실패 시 null로 남고, 그 경우 프론트는 네이버 지도 검색 링크 폴백을 그대로 사용한다.
  latitude                   Float?
  longitude                  Float?
  coverImageUrl              String?                     @map("cover_image_url")
  teamCount                  Int                         @default(8) @map("team_count")
  minPlayers                 Int                         @default(6) @map("min_players")
  maxPlayers                 Int                         @default(10) @map("max_players")
  genderCategory             V1TournamentGenderCategory? @map("gender_category")
  genderMinMale              Int?                        @map("gender_min_male")
  genderMaxMale              Int?                        @map("gender_max_male")
  genderMinFemale            Int?                        @map("gender_min_female")
  genderMaxFemale            Int?                        @map("gender_max_female")
  entryFee                   Int                         @default(0) @map("entry_fee")
  // 상금: prizeSummary=대표 상품/상금 문구, prizeBreakdown=순위별 안내 텍스트(예: "1위 100만원 · 2위 50만원"). prizePool은 하위 호환용 숫자 필드.
  prizePool                  Int?                        @map("prize_pool")
  prizeSummary               String?                     @map("prize_summary")
  prizeBreakdown             String?                     @map("prize_breakdown")
  promoHomeEnabled           Boolean                     @default(false) @map("promo_home_enabled")
  promoHomeTitle             String?                     @map("promo_home_title")
  promoHomeSubtitle          String?                     @map("promo_home_subtitle")
  promoHomeImageUrl          String?                     @map("promo_home_image_url")
  promoHomeBadgeText         String?                     @map("promo_home_badge_text")
  promoHomeDateText          String?                     @map("promo_home_date_text")
  promoHomeTeamsText         String?                     @map("promo_home_teams_text")
  promoHomeLocationText      String?                     @map("promo_home_location_text")
  promoHomePrizeText         String?                     @map("promo_home_prize_text")
  promoHomePriority          Int                         @default(0) @map("promo_home_priority")
  promoListEnabled           Boolean                     @default(false) @map("promo_list_enabled")
  promoListTitle             String?                     @map("promo_list_title")
  promoListSubtitle          String?                     @map("promo_list_subtitle")
  promoListImageUrl          String?                     @map("promo_list_image_url")
  promoListBadgeText         String?                     @map("promo_list_badge_text")
  promoListDateText          String?                     @map("promo_list_date_text")
  promoListTeamsText         String?                     @map("promo_list_teams_text")
  promoListLocationText      String?                     @map("promo_list_location_text")
  promoListPrizeText         String?                     @map("promo_list_prize_text")
  promoListPriority          Int                         @default(0) @map("promo_list_priority")
  bankName                   String?                     @map("bank_name")
  bankAccount                String?                     @map("bank_account")
  bankHolder                 String?                     @map("bank_holder")
  /// 경고 누적 출전정지 규정 — 옐로 몇 장이 쌓이면 다음 경기 출전이 막히는가.
  /// 1차 대회(2026-08-15~16) 회고 "옐로카드 누적, 레드카드 퇴장등 필요해보임".
  /// 지금까지 카드는 경기 단위로만 집계됐고 다음 경기 라인업 제출은 아무것도
  /// 검사하지 않아, 레드카드를 받은 선수가 그대로 다음 경기에 뛸 수 있었다.
  ///
  /// **null = 이 대회에는 카드 정지 규정을 적용하지 않는다.** 기본값을 두지 않은
  /// 이유가 중요하다 — 값이 있으면 배포 즉시 **이미 진행된 대회들에 소급 적용**돼
  /// 다수 선수가 갑자기 "출전정지"로 뜬다. null 기본값이 그 사고를 원천 차단하고,
  /// 2026-08-23 사용자 결정(Q4-A "대회 생성 시 관리자가 규정값 직접 설정")과도
  /// 정확히 맞는다. 운영자가 켜는 순간부터 그 대회에만 적용된다.
  yellowAccumulationLimit    Int?                        @map("yellow_accumulation_limit")
  /// 레드카드(퇴장) 1장당 출전정지 경기 수. null 이면 레드카드 정지 미적용.
  /// `yellowAccumulationLimit` 과 독립적으로 켤 수 있다 — 대회마다 "경고 누적만
  /// 본다"거나 "퇴장만 본다"가 다르기 때문이다.
  redCardSuspensionMatches   Int?                        @map("red_card_suspension_matches")
  rulesText                  String?                     @map("rules_text")
  refundPolicyText           String?                     @map("refund_policy_text")
  createdByAdminUserId       String?                     @map("created_by_admin_user_id")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  deletedAt                  DateTime?                   @map("deleted_at")
  // Nullable / no default until the deferred contract-phase migration adds
  // SET NOT NULL + SET DEFAULT — see
  // docs/ops/task9-competition-config-contract-phase.md. The FK constraint
  // itself (v1_tournaments_competition_config_fk) already exists (added by
  // 20260729000200_v1_competition_config while this column was still
  // nullable), so `competitionConfig` stays a real relation, just optional.
  competitionConfigVersionId String?                     @map("competition_config_version_id")
  /** 리그전에서 각 팀이 최소 몇 경기를 보장받는지. null이면 검증하지 않는다. */
  minMatchesPerTeam          Int?                        @map("min_matches_per_team")
  // ── 통합 축 (R1 expand, 아직 읽는 코드 없음) ───────────────────────────────
  /// 단발 대회 / 정규 리그 시즌 구분. nullable + default 라서 기존 행은 전부
  /// regular_tournament 로 채워지고(사실과 일치한다), NOT NULL 승격은 read-swap 이
  /// 안정된 뒤 R5 로 미룬다 — expand 단계의 되돌리기를 컬럼 드롭 하나로 유지하기 위해서다.
  kind                       V1CompetitionKind?          @default(regular_tournament)
  /// 아래 셋은 정규 리그 시즌에만 채워지고 항상 함께 채워지거나 함께 null 이다 —
  /// V1League 의 같은 세 컬럼이 이관돼 올 자리이며, 그쪽 주석의 근거(단발 대회에
  /// "1부" 뱃지가 잘못 붙지 않게 tier 에 기본값 1 을 주지 않는다)를 그대로 승계한다.
  seriesId                   String?                     @map("series_id")
  /// R4-a expand — 리그를 통합 축에서 그리려면 지역이 필요하다. `V1League.regionId` 는
  /// **NOT NULL** 이지만 여기서는 nullable 이다: 기존 대회 행에는 지역이 없고, expand 는
  /// 기존 행을 건드리지 않는 것이 규칙이라 NOT NULL 로 못 만든다. 리그에서 넘어온 행은
  /// R4-a 백필이 채운다(88행 전부 값이 있다 — 원본이 NOT NULL 이라 빈칸이 안 생긴다).
  regionId                   String?                     @map("region_id")
  tier                       Int?
  seasonNo                   Int?                        @map("season_no")

  sport                V1Sport                              @relation(fields: [sportId], references: [id], onDelete: Restrict)
  series               V1LeagueSeries?                      @relation("V1TournamentSeries", fields: [seriesId], references: [id], onDelete: SetNull, map: "v1_tournaments_series_fk")
  region               V1Region?                            @relation("V1TournamentRegion", fields: [regionId], references: [id], onDelete: Restrict, map: "v1_tournaments_region_fk")
  competitionConfig    V1CompetitionConfigVersion?          @relation("V1TournamentCompetitionConfig", fields: [competitionConfigVersionId], references: [id], onDelete: Restrict, map: "v1_tournaments_competition_config_fk")
  createdByAdmin       V1AdminUser?                         @relation("V1TournamentCreatedByAdmin", fields: [createdByAdminUserId], references: [id], onDelete: SetNull)
  registrations        V1TournamentRegistration[]
  /// BE-5 drop: 리그 대진과 승강 기록이 `V1League` 대신 여기를 가리킨다(kind='regular_league'
  /// 인 행에만 실제로 값이 온다 — 일반 대회는 자기 픽스처 테이블을 쓴다).
  leagueTeamMatches    V1TeamMatch[]                        @relation("V1TeamMatchLeague")
  leaguePromotions     V1LeaguePromotion[]                  @relation("V1LeaguePromotionFromLeague")
  groups               V1TournamentGroup[]
  fixtures             V1TournamentFixture[]
  announcements        V1TournamentAnnouncement[]
  sponsors             V1TournamentSponsor[]
  reviews              V1TournamentReview[]
  awards               V1TournamentAward[]
  campaign             V1TournamentCampaign?
  popups               V1TournamentPopup[]
  fields               V1TournamentField[]
  staffAssignments     V1TournamentStaffAssignment[]
  operationAudits      V1OperationAudit[]
  advancementEdges     V1TournamentFixtureAdvancementEdge[]
  officialResultCaches V1GameOfficialResultCache[]
  overallStandings     V1TournamentOverallStanding[]

  @@index([status, scheduledAt])
  @@index([sportId, status])
  /// `V1League` 의 `@@index([regionId, state])` 를 승계한다 — 지역 필터 + 상태로 좁히는
  /// 공개 목록 질의가 그 인덱스를 타려고 만든 것이었다(2026-08-21 재감사).
  @@index([regionId, status])
  @@index([competitionConfigVersionId], map: "v1_tournaments_competition_config_idx")
  // 한 시리즈의 (시즌, 티어) 조합은 하나뿐이다 — V1League 의
  // v1_leagues_series_season_tier_key 와 같은 불변식을 통합 쪽에도 미리 건다.
  // 세 컬럼 다 이 마이그레이션에서 새로 생긴 nullable 컬럼이라 기존 대회 행은 전부
  // NULL 이고, Postgres 는 NULL 끼리 충돌로 보지 않으므로 기존 행끼리는 걸리지 않는다.
  @@unique([seriesId, seasonNo, tier], map: "v1_tournaments_series_season_tier_key")
  @@map("v1_tournaments")
}

model V1TournamentCampaign {
  id           String                     @id @default(uuid())
  tournamentId String                     @unique @map("tournament_id")
  slug         String                     @unique
  status       V1TournamentCampaignStatus @default(draft)
  content      Json
  publishedAt  DateTime?                  @map("published_at")
  archivedAt   DateTime?                  @map("archived_at")
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  tournament V1Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("v1_tournament_campaigns")
}

/// 대회 참가팀 후기 (status=completed 이후, 확정 등록된 팀만 작성 가능)
model V1TournamentReview {
  id           String    @id @default(uuid())
  tournamentId String    @map("tournament_id")
  authorUserId String    @map("author_user_id")
  // 리뷰가 귀속되는 팀. 팀장·운영진(manager+) 누구나 작성 가능해지면서 "누가 썼는지"와
  // "어느 팀 리뷰인지"가 분리됐다 — nullable인 이유는 (a) 마이그레이션 백필 시 같은
  // (tournamentId, teamId) 조합에 중복 리뷰가 있던 레거시 행 중 가장 이른 1건만 채우고
  // 나머지는 NULL로 보존하기 때문, (b) 팀 삭제는 이 스키마에서 항상 soft delete(deletedAt)라
  // onDelete: Restrict가 걸리지만, 그래도 스키마 자체는 nullable로 열어 둔다.
  teamId       String?   @map("team_id")
  teamName     String?   @map("team_name") // 작성자 팀명 (snapshot)
  rating       Int // 1~5
  comment      String?   @db.Text
  photoUrls    String[]  @default([]) @map("photo_urls")
  hiddenAt     DateTime? @map("hidden_at")
  hiddenReason String?   @map("hidden_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tournament V1Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  author     V1User       @relation("V1TournamentReviewAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  // Restrict: V1Team은 이 코드베이스에서 물리적으로 delete되지 않는다(항상 deletedAt soft
  // delete) — 다른 v1_tournament_registrations.team 관계도 동일하게 Restrict를 쓴다. 리뷰가
  // 팀 삭제로 사라지는 경로 자체를 DB 레벨에서 막는 것이 SetNull보다 강한 보장이다.
  team       V1Team?      @relation("V1TournamentReviewTeam", fields: [teamId], references: [id], onDelete: Restrict)

  // 대회당 사람 1건. "팀당 1건"(@@unique([tournamentId, teamId]))은 2026-08-17에 드롭했다 —
  // 같은 팀의 팀장이 먼저 쓰면 운영진이 ALREADY_REVIEWED 로 막혔는데, 경기 후기는 이미 사람
  // 기준이라(773f211f) 같은 성격의 평가가 두 도메인에서 다르게 동작했다. 대회 후기 평점은
  // 어디에서도 집계되지 않고 개별 항목으로만 노출되므로, 인원 많은 팀 쪽으로 점수가 기우는
  // 문제도 생기지 않는다.
  @@unique([tournamentId, authorUserId])
  @@index([tournamentId, createdAt])
  @@map("v1_tournament_reviews")
}

/// 대회 개인 어워드 (MVP, 득점왕 등) - 어드민이 수동 입력
model V1TournamentAward {
  id            String   @id @default(uuid())
  tournamentId  String   @map("tournament_id")
  awardType     String   @map("award_type") // 'mvp' | 'top_scorer' | 'best_defense' | etc.
  awardLabel    String   @map("award_label") // 표시명: 'MVP', '득점왕', '베스트 11' 등
  iconKey       String?  @map("icon_key") // trophy | crown | goal | shield | glove | handshake | sparkles | medal | star
  recipientName   String  @map("recipient_name") // 수상자 이름
  recipientUserId String? @map("recipient_user_id")
  teamName      String?  @map("team_name") // 수상자 팀명
  note          String? // 추가 설명
  sortOrder     Int      @default(0) @map("sort_order") // 표시 순서
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tournament V1Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  recipient  V1User?      @relation("V1TournamentAwardRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, awardType])
  @@index([tournamentId, sortOrder])
  @@index([recipientUserId, createdAt])
  @@map("v1_tournament_awards")
}

model V1TournamentRegistration {
  id                       String                          @id @default(uuid())
  tournamentId             String                          @map("tournament_id")
  teamId                   String                          @map("team_id")
  appliedByUserId          String                          @map("applied_by_user_id")
  status                   V1TournamentRegistrationStatus  @default(draft)
  depositorName            String?                         @map("depositor_name")
  agreedRules              Boolean                         @default(false) @map("agreed_rules")
  agreedPrivacy            Boolean                         @default(false) @map("agreed_privacy")
  agreedRefund             Boolean                         @default(false) @map("agreed_refund")
  agreedMediaConsent       Boolean                         @default(false) @map("agreed_media_consent")
  confirmedByAdminUserId   String?                         @map("confirmed_by_admin_user_id")
  confirmedAt              DateTime?                       @map("confirmed_at")
  rosterLockedAt           DateTime?                       @map("roster_locked_at")
  rosterDeadlineOverrideAt DateTime?                       @map("roster_deadline_override_at")
  cancelRequestedAt        DateTime?                       @map("cancel_requested_at")
  cancelPreviousStatus     V1TournamentRegistrationStatus? @map("cancel_previous_status")
  cancelReason             String?                         @map("cancel_reason")
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")
  // ── 통합 축 (R1 expand, 아직 읽는 코드 없음) ─────────────────────────────────
  /// 이 팀이 대회에 들어온 경로(D7). 기존 행은 전부 팀이 직접 신청해 만들어진
  /// 것이므로(v1_tournament_registrations 를 만드는 경로는 신청 서비스와 목업 시더
  /// 둘뿐이다) default 가 곧 사실이다. NOT NULL 승격은 R5 로 미룬다.
  entrySource              V1CompetitionEntrySource?       @default(applied) @map("entry_source")
  /// D9 — 정원 초과 시 운영자가 승인·거부·티어 이동을 직접 판단하고 그 사유를 남긴다.
  /// 필수 여부는 서비스 계층에서 강제한다(몰수·정정이 이미 쓰는 방식과 같다) —
  /// 컬럼을 NOT NULL 로 걸면 사유가 필요 없는 기존/자동 등록 행까지 막힌다.
  adjustmentNote           String?                         @map("adjustment_note")
  /// D10(Task 164 BE-4b) — 시즌 시작 시각에 명단 미제출 팀의 명단을 자동 생성한 시각.
  /// **boolean 이 아니라 시각**인 이유: 어드민 배지는 "자동 확정됨" 만 물어보지만,
  /// 운영 문의는 늘 "언제" 를 함께 묻는다(수동 확정과 시점이 겹칠 때 어느 쪽이 먼저였는지).
  /// 선수 단위(누가 자동으로 들어왔는지)로 쪼개지 않는다 — 164 의 배지 요구가 팀 단위이고,
  /// 선수 단위 구분을 쓸 화면이 아직 없다.
  rosterAutoConfirmedAt    DateTime?                       @map("roster_auto_confirmed_at")

  tournament       V1Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team             V1Team                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  appliedByUser    V1User                  @relation("V1TournamentRegistrationApplicant", fields: [appliedByUserId], references: [id], onDelete: Restrict)
  confirmedByAdmin V1AdminUser?            @relation("V1TournamentRegistrationConfirmedByAdmin", fields: [confirmedByAdminUserId], references: [id], onDelete: SetNull)
  players          V1TournamentPlayer[]
  payment          V1TournamentPayment?
  groupTeams       V1TournamentGroupTeam[]
  homeFixtures     V1TournamentFixture[]   @relation("V1TournamentFixtureHome")
  awayFixtures     V1TournamentFixture[]   @relation("V1TournamentFixtureAway")
  standings        V1TournamentStanding[]
  overallStandings V1TournamentOverallStanding[]

  @@unique([tournamentId, teamId])
  @@index([tournamentId, status])
  @@index([teamId])
  @@index([appliedByUserId])
  @@map("v1_tournament_registrations")
}

model V1TournamentPlayer {
  id                String                        @id @default(uuid())
  registrationId    String                        @map("registration_id")
  userId            String                        @map("user_id")
  realName          String                        @map("real_name")
  birthDateSnapshot String?                       @map("birth_date_snapshot")
  genderSnapshot    String?                       @map("gender_snapshot")
  eligibilityStatus V1TournamentPlayerEligibility @default(needs_review) @map("eligibility_status")
  eligibilityNote   String?                       @map("eligibility_note")
  addedAt           DateTime                      @default(now()) @map("added_at")
  removedAt         DateTime?                     @map("removed_at")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")

  registration V1TournamentRegistration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user         V1User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  goals        V1TournamentFixtureGoal[]

  @@unique([registrationId, userId])
  @@index([registrationId, removedAt])
  @@index([userId])
  @@index([eligibilityStatus])
  @@map("v1_tournament_players")
}

model V1TournamentPayment {
  id                     String                    @id @default(uuid())
  registrationId         String                    @unique @map("registration_id")
  method                 V1TournamentPaymentMethod
  provider               String?
  providerTxId           String?                   @map("provider_tx_id")
  amount                 Int
  status                 V1TournamentPaymentStatus @default(ready)
  paidAt                 DateTime?                 @map("paid_at")
  cancelledAt            DateTime?                 @map("cancelled_at")
  refundedAt             DateTime?                 @map("refunded_at")
  confirmedByAdminUserId String?                   @map("confirmed_by_admin_user_id")
  rawWebhookRef          String?                   @map("raw_webhook_ref")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  registration     V1TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  confirmedByAdmin V1AdminUser?             @relation("V1TournamentPaymentConfirmedByAdmin", fields: [confirmedByAdminUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([providerTxId])
  @@map("v1_tournament_payments")
}

model V1TournamentGroup {
  id           String                 @id @default(uuid())
  tournamentId String                 @map("tournament_id")
  name         String
  phase        V1TournamentGroupPhase @default(group)
  sortOrder    Int                    @default(0) @map("sort_order")
  // 이 조에서 상위 몇 팀이 다음 단계로 진출하는지(조별리그 진출선 표시용). null이면 진출 표시 없음.
  advanceCount Int?                   @map("advance_count")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  tournament V1Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupTeams V1TournamentGroupTeam[]
  fixtures   V1TournamentFixture[]
  standings  V1TournamentStanding[]

  @@unique([tournamentId, name], map: "v1_tournament_groups_tournament_id_name_key")
  @@index([tournamentId, phase, sortOrder])
  @@map("v1_tournament_groups")
}

model V1TournamentGroupTeam {
  id             String   @id @default(uuid())
  groupId        String   @map("group_id")
  registrationId String   @map("registration_id")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  group        V1TournamentGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  registration V1TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([groupId, registrationId])
  @@index([registrationId])
  @@map("v1_tournament_group_teams")
}

model V1TournamentFixture {
  id                         String                    @id @default(uuid())
  tournamentId               String                    @map("tournament_id")
  groupId                    String?                   @map("group_id")
  round                      String
  fixtureNumber              Int                       @map("fixture_number")
  legNumber                  Int                       @default(1) @map("leg_number")
  parentFixtureId            String?                   @map("parent_fixture_id")
  homeRegistrationId         String?                   @map("home_registration_id")
  awayRegistrationId         String?                   @map("away_registration_id")
  scheduledAt                DateTime?                 @map("scheduled_at")
  fieldId                    String?                   @map("field_id")
  venue                      String?
  status                     V1TournamentFixtureStatus @default(scheduled)
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  // Nullable / no default until the deferred contract-phase migration adds
  // SET NOT NULL + SET DEFAULT — see
  // docs/ops/task9-competition-config-contract-phase.md. The FK constraint
  // itself (v1_tournament_fixtures_competition_config_fk) already exists
  // (added by 20260729000100_v1_game_operations while this column was still
  // nullable there too), so `competitionConfig` stays a real relation, just
  // optional.
  competitionConfigVersionId String?                   @map("competition_config_version_id")

  tournament         V1Tournament                         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group              V1TournamentGroup?                   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  parentFixture      V1TournamentFixture?                 @relation("V1TournamentFixtureParent", fields: [parentFixtureId], references: [id], onDelete: SetNull)
  childFixtures      V1TournamentFixture[]                @relation("V1TournamentFixtureParent")
  homeRegistration   V1TournamentRegistration?            @relation("V1TournamentFixtureHome", fields: [homeRegistrationId], references: [id], onDelete: SetNull)
  awayRegistration   V1TournamentRegistration?            @relation("V1TournamentFixtureAway", fields: [awayRegistrationId], references: [id], onDelete: SetNull)
  result             V1TournamentFixtureResult?
  videos             V1TournamentFixtureVideo[]
  game               V1Game?                              @relation("V1GameTournamentFixture")
  competitionConfig  V1CompetitionConfigVersion?          @relation("V1FixtureCompetitionConfig", fields: [competitionConfigVersionId], references: [id], onDelete: Restrict, map: "v1_tournament_fixtures_competition_config_fk")
  field              V1TournamentField?                   @relation(fields: [tournamentId, fieldId], references: [tournamentId, id], onDelete: Restrict, map: "v1_tournament_fixtures_field_fk")
  staffScopes        V1TournamentStaffFixtureScope[]
  operationAudits    V1OperationAudit[]
  advancementSources V1TournamentFixtureAdvancementEdge[] @relation("V1FixtureAdvancementSource")
  advancementTargets V1TournamentFixtureAdvancementEdge[] @relation("V1FixtureAdvancementTarget")

  @@unique([tournamentId, id], map: "v1_tournament_fixtures_tournament_id_id_key")
  @@unique([tournamentId, round, fixtureNumber, legNumber], map: "v1_tournament_fixtures_tournament_round_number_leg_key")
  @@index([tournamentId, round, fixtureNumber])
  @@index([groupId])
  @@index([parentFixtureId])
  @@index([competitionConfigVersionId], map: "v1_tournament_fixtures_competition_config_idx")
  @@index([status, id], map: "v1_tournament_fixtures_status_id_backfill_idx")
  @@map("v1_tournament_fixtures")
}

model V1TournamentFixtureResult {
  id                    String   @id @default(uuid())
  fixtureId             String   @unique @map("fixture_id")
  homeScore             Int      @default(0) @map("home_score")
  awayScore             Int      @default(0) @map("away_score")
  hasPenalty            Boolean  @default(false) @map("has_penalty")
  homePenaltyScore      Int?     @map("home_penalty_score")
  awayPenaltyScore      Int?     @map("away_penalty_score")
  note                  String?
  recordedByAdminUserId String?  @map("recorded_by_admin_user_id")
  recordedAt            DateTime @default(now()) @map("recorded_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  fixture         V1TournamentFixture       @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  recordedByAdmin V1AdminUser?              @relation("V1TournamentFixtureResultRecordedByAdmin", fields: [recordedByAdminUserId], references: [id], onDelete: SetNull)
  goals           V1TournamentFixtureGoal[]

