  contactRequestsSent          V1TeamContact[]             @relation("V1TeamContactFromTeam")
  contactRequestsReceived      V1TeamContact[]             @relation("V1TeamContactToTeam")
  contactBlocksMade            V1TeamContactBlock[]        @relation("V1TeamContactBlockOwner")
  contactBlocksReceived        V1TeamContactBlock[]        @relation("V1TeamContactBlockTarget")
  reportedInquiries            V1Inquiry[]                 @relation("V1InquiryReportedTeam")

  @@index([ownerUserId])
  @@index([sportId, regionId, status])
  @@index([status])
  @@index([createdAt])
  @@map("v1_teams")
}

model V1TeamProfile {
  id                String    @id @default(uuid())
  teamId            String    @unique @map("team_id")
  logoUrl           String?   @map("logo_url")
  coverImageUrl     String?   @map("cover_image_url")
  description       String?
  activityNote      String?   @map("activity_note")
  activityDays      String[]  @default([]) @map("activity_days")
  activityFrequency String?   @map("activity_frequency")
  activityTimeSlots String[]  @default([]) @map("activity_time_slots")
  activityTypes     String[]  @default([]) @map("activity_types")
  skillNote         String?   @map("skill_note")
  minSportLevelId   String?   @map("min_sport_level_id")
  maxSportLevelId   String?   @map("max_sport_level_id")
  genderRule        String?   @map("gender_rule")
  memberGoalCount   Int?      @map("member_goal_count")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  team          V1Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  minSportLevel V1SportLevel? @relation("V1TeamProfileMinSportLevel", fields: [minSportLevelId], references: [id], onDelete: SetNull)
  maxSportLevel V1SportLevel? @relation("V1TeamProfileMaxSportLevel", fields: [maxSportLevelId], references: [id], onDelete: SetNull)

  @@index([minSportLevelId])
  @@index([maxSportLevelId])
  @@map("v1_team_profiles")
}

model V1TeamMembership {
  id              String                 @id @default(uuid())
  teamId          String                 @map("team_id")
  userId          String                 @map("user_id")
  role            V1TeamMembershipRole   @default(member)
  status          V1TeamMembershipStatus @default(active)
  joinedAt        DateTime?              @map("joined_at")
  leftAt          DateTime?              @map("left_at")
  removedByUserId String?                @map("removed_by_user_id")
  /// 팀이 이 멤버에게 지정한 고정 등번호(영구 번호). 라인업 화면에서 등번호를 고쳐도
  /// 이 값은 바뀌지 않는다 — 한 경기의 임시 번호가 팀 기본값을 조용히 덮어쓰면 안 되므로
  /// 팀원 관리 화면에서만 명시적으로 바꾼다. 라인업의 등번호 자동 채움은 이 값을
  /// 2순위로 쓴다(1순위는 불러온 라인업의 값, 3순위는 그 선수가 직전에 달았던 번호).
  jerseyNumber    Int?                   @map("jersey_number")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  team          V1Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          V1User  @relation("V1TeamMember", fields: [userId], references: [id], onDelete: Restrict)
  removedByUser V1User? @relation("V1TeamMembershipRemover", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@unique([teamId, userId])
  /// 한 팀 안에서 같은 등번호를 두 사람이 가질 수 없다. Postgres는 NULL을 서로 다른
  /// 값으로 취급하므로 번호를 지정하지 않은 멤버는 몇 명이든 공존한다.
  @@unique([teamId, jerseyNumber], map: "v1_team_memberships_team_id_jersey_number_key")
  @@index([userId, status])
  @@index([teamId, role, status])
  @@map("v1_team_memberships")
}

/// 팀이 이름을 붙여 저장해 두는 라인업 템플릿("주전 4-4-2", "주말 리그용" 등).
///
/// 경기 스냅샷(V1GameLineup/V1GameParticipant)과 의도적으로 다른 테이블이다. 스냅샷은
/// "그날 실제로 이렇게 뛰었다"는 기록이라 사후에 바뀌면 안 되지만, 프리셋은 팀이 계속
/// 고쳐 쓰는 살아있는 템플릿이고 불러올 때마다 **현재의** 이름·자격으로 다시 해석된다.
model V1TeamLineupPreset {
  id              String   @id @default(uuid())
  teamId          String   @map("team_id")
  name            String
  /// 포메이션 프리셋 라벨(예: "4-4-2"). null이면 자유 배치.
  formation       String?
  /// 저장 당시 종목 이름(예: "축구"). 불러오기 목록에서 지금 화면의 종목과 다르면 경고
  /// 배지를 붙이기 위한 표시용 값이며, 불러오기를 막는 데는 쓰지 않는다 — 대회와 팀
  /// 매치를 가로질러 재사용하는 것이 이 기능의 의도다.
  sportName       String?  @map("sport_name")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  team    V1Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  entries V1TeamLineupPresetEntry[]

  @@unique([teamId, name], map: "v1_team_lineup_presets_team_id_name_key")
  @@index([teamId, updatedAt], map: "v1_team_lineup_presets_team_id_updated_at_idx")
  @@map("v1_team_lineup_presets")
}

model V1TeamLineupPresetEntry {
  id           String   @id @default(uuid())
  presetId     String   @map("preset_id")
  /// 연동 팀원이면 userId. 이 값이 있으면 불러올 때 이름이 아니라 사람으로 대조하므로
  /// 그 사이 닉네임이 바뀌어도 같은 사람으로 이어진다. FK를 걸지 않는 이유는
  /// V1GameParticipant.userId와 같다 — 사용자 탈퇴가 팀의 템플릿을 막아서는 안 된다.
  userId       String?  @map("user_id")
  /// 저장 시점의 표시 이름. 게스트(userId=null)에게는 유일한 신원이고, 연동 팀원에게는
  /// 그 사람이 팀을 떠난 뒤에도 목록에 이름을 보여주기 위한 폴백이다.
  displayName  String   @map("display_name")
  jerseyNumber Int?     @map("jersey_number")
  /// 포지션 코드(DF/MF/FW 등). 골키퍼는 이 컬럼이 아니라 goalkeeper 플래그로 표시한다.
  position     String?
  /// 피치 배치 좌표, 0~100 퍼센트. 선발에만 있고 둘 다 있거나 둘 다 없다.
  positionX    Float?   @map("position_x")
  positionY    Float?   @map("position_y")
  started      Boolean  @default(true)
  /// 골키퍼 여부를 종목 코드가 아니라 **의미**로 저장한다. 경기 스냅샷은 종목별 코드
  /// (축구 'GK', 풋살 'GOLEIRO')를 position에 넣지만, 프리셋은 종목이 다른 화면으로도
  /// 불려갈 수 있어 코드를 그대로 옮기면 골키퍼를 못 알아본다 — 적용 시점에 그 화면의
  /// 골키퍼 코드로 변환한다.
  goalkeeper   Boolean  @default(false)
  sortOrder    Int      @map("sort_order")

  preset V1TeamLineupPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@index([presetId, sortOrder], map: "v1_team_lineup_preset_entries_preset_id_sort_order_idx")
  @@map("v1_team_lineup_preset_entries")
}

// ── 전술보드 (R1 expand — 테이블만 만들고 읽는 코드는 Phase 1) ─────────────────
// "누가 뛰는가"(명단 → V1GameParticipant)와 "어떻게 배치하는가"를 서로 다른 축으로
// 떼어 놓기 위한 저장소다. 지금은 선발/후보·포지션·좌표가 V1GameParticipant 의 컬럼이라
// 라인업을 저장할 때마다 참가자 행이 바뀌고(중복 누적 사고의 뿌리), 전술이 공식 결과
// 스냅샷에 섞여 상대팀에 노출된다. 그 세 값의 책임이 Phase 1 에서 이리로 넘어온다.
//
// 이 테이블은 **새로 만드는 것이 아니라** 바로 위 V1TeamLineupPreset 층을 확장한 것이다:
// 프리셋 = 경기와 무관한 팀 템플릿, 보드 = 그 팀의 이 경기 배치. 그래서 사람을 가리키는
// 방식(userId nullable + displayName 스냅샷)과 골키퍼를 종목 코드가 아니라 의미로 두는
// 규칙을 프리셋 쪽에서 그대로 가져왔다 — 두 층 사이에서 값을 옮길 때 변환이 필요 없다.
//
// 축을 (game, side) 로 잡은 이유: 대회 픽스처·친선 팀매치·리그 대진이 위 계층에서는
// 갈라져 있지만 그 아래 V1Game 은 셋이 공유하는 한 엔진이고, 대체 대상인 V1GameLineup
// 자체가 (gameId, sideId) 로 열리기 때문이다. fixtureId 로 잡으면 통합 전에는 가리키는
// 테이블이 둘이 된다.
model V1TeamTacticsBoard {
  id     String @id @default(uuid())
  gameId String @map("game_id")
  /// 한 경기의 한 사이드에 보드는 하나뿐이다. 개정 이력을 쌓지 않는 것이 V1GameLineup 과
  /// 다른 점이자 이 설계의 요점이다 — 보드는 몇 번을 고쳐도 기록에 영향이 없으므로
  /// 리비전으로 과거를 붙잡아 둘 이유가 없다.
  sideId String @unique @map("side_id")
  /// 보드를 소유한 팀. 가시성이 "그 팀 멤버만"이라 판정 주체가 반드시 필요하다.
  /// V1GameSide.teamId 는 게스트 상대를 위해 nullable 이지만, 팀 없는 사이드에는
  /// 보드를 열 주체 자체가 없으므로 여기서는 NOT NULL 이다.
  teamId String @map("team_id")
  /// 포메이션 프리셋 라벨(예: "4-4-2"). null이면 자유 배치. 실제 좌표는 entries 에 있다.
  formation       String?
  /// 낙관적 잠금용. 팀 운영진 여럿이 같은 보드를 동시에 고칠 수 있고, 그 충돌은
  /// 기록이 아니라 화면의 문제라 V1GameLineup 과 같은 방식으로 처리한다.
  version         Int      @default(0)
  /// 마지막으로 저장한 사람. V1TeamLineupPreset.createdByUserId 와 같은 이유로 FK 를 걸지
  /// 않는다 — 사용자 탈퇴가 팀의 전술보드를 막아서는 안 된다.
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  game    V1Game                    @relation("V1TeamTacticsBoardGame", fields: [gameId], references: [id], onDelete: Cascade, map: "v1_team_tactics_boards_game_fk")
  side    V1GameSide                @relation("V1TeamTacticsBoardSide", fields: [sideId], references: [id], onDelete: Cascade, map: "v1_team_tactics_boards_side_fk")
  team    V1Team                    @relation("V1TeamTacticsBoardTeam", fields: [teamId], references: [id], onDelete: Restrict, map: "v1_team_tactics_boards_team_fk")
  entries V1TeamTacticsBoardEntry[]

  @@index([gameId], map: "v1_team_tactics_boards_game_id_idx")
  @@index([teamId, updatedAt], map: "v1_team_tactics_boards_team_id_updated_at_idx")
  @@map("v1_team_tactics_boards")
}

model V1TeamTacticsBoardEntry {
  id      String @id @default(uuid())
  boardId String @map("board_id")
  /// 연동 팀원이면 userId. V1TeamLineupPresetEntry 와 같은 이유로 FK 를 걸지 않고,
  /// 같은 이유로 nullable 이다(게스트에게는 displayName 이 유일한 신원).
  /// Phase 1 에서 참가자 행(V1GameParticipant)과 맞물릴 때 대조 키가 되는 값이다 —
  /// participantId 를 들지 않는 이유는 참가자 행이 지금도 라인업 저장마다 다시
  /// 만들어져(그것이 Phase 1 이 고치는 결함이다) 보드가 조용히 끊기기 때문이다.
  userId       String?  @map("user_id")
  displayName  String   @map("display_name")
  jerseyNumber Int?     @map("jersey_number")
  /// 포지션 코드(DF/MF/FW 등). 골키퍼는 이 컬럼이 아니라 goalkeeper 플래그로 표시한다.
  position     String?
  /// 피치 배치 좌표, 0~100 퍼센트. 선발에만 있고 둘 다 있거나 둘 다 없다.
  positionX    Float?   @map("position_x")
  positionY    Float?   @map("position_y")
  started      Boolean  @default(true)
  /// 프리셋과 같게 **의미**로 저장한다 — 종목마다 코드가 다르고(축구 'GK', 풋살
  /// 'GOLEIRO') 보드는 종목이 다른 화면으로도 불려갈 수 있다.
  goalkeeper   Boolean  @default(false)
  sortOrder    Int      @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  board V1TeamTacticsBoard @relation(fields: [boardId], references: [id], onDelete: Cascade, map: "v1_team_tactics_board_entries_board_fk")

  @@index([boardId, sortOrder], map: "v1_team_tactics_board_entries_board_id_sort_idx")
  @@map("v1_team_tactics_board_entries")
}

model V1TeamJoinApplication {
  id               String                      @id @default(uuid())
  teamId           String                      @map("team_id")
  applicantUserId  String                      @map("applicant_user_id")
  status           V1TeamJoinApplicationStatus @default(requested)
  message          String?
  reviewedByUserId String?                     @map("reviewed_by_user_id")
  reviewedAt       DateTime?                   @map("reviewed_at")
  withdrawnAt      DateTime?                   @map("withdrawn_at")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  team           V1Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  applicantUser  V1User  @relation("V1TeamJoinApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewedByUser V1User? @relation("V1TeamJoinReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([teamId, applicantUserId])
  @@index([applicantUserId, status])
  @@index([status])
  @@index([createdAt])
  @@map("v1_team_join_applications")
}

model V1TeamInvitation {
  id              String                 @id @default(uuid())
  teamId          String                 @map("team_id")
  invitedUserId   String                 @map("invited_user_id")
  invitedByUserId String                 @map("invited_by_user_id")
  status          V1TeamInvitationStatus @default(pending)
  message         String?
  respondedAt     DateTime?              @map("responded_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  team          V1Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedUser   V1User @relation("V1TeamInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedByUser V1User @relation("V1TeamInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([teamId, invitedUserId])
  @@index([invitedUserId, status])
  @@index([teamId, status])
  @@map("v1_team_invitations")
}

model V1TeamContact {
  id                String              @id @default(uuid())
  fromTeamId        String              @map("from_team_id")
  toTeamId          String              @map("to_team_id")
  requestedByUserId String              @map("requested_by_user_id")
  message           String                                      // 1~500자 (V1TeamMatchApplication.message와 동일 상한)
  status            V1TeamContactStatus @default(requested)
  respondedByUserId String?             @map("responded_by_user_id")
  respondedAt       DateTime?           @map("responded_at")
  declineReason     String?             @map("decline_reason")  // 200자 이하
  expiresAt         DateTime            @map("expires_at")      // createdAt + 7일
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  fromTeam        V1Team      @relation("V1TeamContactFromTeam", fields: [fromTeamId], references: [id], onDelete: Cascade)
  toTeam          V1Team      @relation("V1TeamContactToTeam", fields: [toTeamId], references: [id], onDelete: Cascade)
  requestedByUser V1User      @relation("V1TeamContactRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  respondedByUser V1User?     @relation("V1TeamContactRespondedBy", fields: [respondedByUserId], references: [id], onDelete: SetNull)
  chatRoom        V1ChatRoom?

  @@index([fromTeamId, toTeamId, status])  // 중복/파편화 체크 (정방향)
  @@index([toTeamId, status])              // 받은함 목록 + 역방향 중복 체크
  @@index([fromTeamId, createdAt])         // 일일 발송 한도 카운트
  @@map("v1_team_contacts")
}

model V1TeamContactBlock {
  id              String   @id @default(uuid())
  teamId          String   @map("team_id")           // 차단을 건 팀
  blockedTeamId   String   @map("blocked_team_id")   // 차단당한 팀
  createdByUserId String   @map("created_by_user_id")
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at")

  team          V1Team @relation("V1TeamContactBlockOwner", fields: [teamId], references: [id], onDelete: Cascade)
  blockedTeam   V1Team @relation("V1TeamContactBlockTarget", fields: [blockedTeamId], references: [id], onDelete: Cascade)
  createdByUser V1User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([teamId, blockedTeamId])
  @@index([blockedTeamId])
  @@map("v1_team_contact_blocks")
}

model V1TeamTrustScore {
  id                    String       @id @default(uuid())
  teamId                String       @unique @map("team_id")
  trustState            V1TrustState @default(sample) @map("trust_state")
  mannerScore           Decimal?     @map("manner_score") @db.Decimal(4, 2)
  matchCount            Int          @default(0) @map("match_count")
  // 대회후기(tournament_fixture) 전용 평점 — team_match 전용 mannerScore와 소스 분리(두 recalculate 함수가 같은 컬럼을 덮어쓰는 문제 방지)
  tournamentMannerScore Decimal?     @map("tournament_manner_score") @db.Decimal(4, 2)
  tournamentReviewCount Int          @default(0) @map("tournament_review_count")
  // trustState/matchCount/sourceLabel과 마찬가지로, 대회후기(tournament_fixture) 전용 컬럼을 분리한다 —
  // 두 컬럼군을 공유하면 recalculateTeamTrust(team_match)와 recalculateTournamentFixtureTeamTrust(tournament_fixture)가
  // 서로 다른 모집단을 계산하면서도 같은 row를 last-write-wins로 덮어써 버린다.
  tournamentTrustState  V1TrustState @default(sample) @map("tournament_trust_state")
  tournamentMatchCount  Int          @default(0) @map("tournament_match_count")
  tournamentSourceLabel String?      @map("tournament_source_label")
  sourceLabel           String?      @map("source_label")
  // 4항목 개별 채점(V1PostEventReviewMetricScore) 평균. 기존 mannerScore(종합 rating 기반)와
  // metricMannerScore(MANNER 항목 단독 평균)는 이름이 비슷하지만 **다른 컬럼**이다 — 합치지 않는다.
  metricSkillScore       Decimal? @map("metric_skill_score") @db.Decimal(4, 2)
  metricPunctualityScore Decimal? @map("metric_punctuality_score") @db.Decimal(4, 2)
  metricSafetyScore      Decimal? @map("metric_safety_score") @db.Decimal(4, 2)
  metricMannerScore      Decimal? @map("metric_manner_score") @db.Decimal(4, 2)
  metricReviewCount      Int      @default(0) @map("metric_review_count")
  // 대회(tournament_fixture) 전용 분리 — 위 tournament* 컬럼들과 같은 이유다.
  tournamentMetricSkillScore       Decimal? @map("tournament_metric_skill_score") @db.Decimal(4, 2)
  tournamentMetricPunctualityScore Decimal? @map("tournament_metric_punctuality_score") @db.Decimal(4, 2)
  tournamentMetricSafetyScore      Decimal? @map("tournament_metric_safety_score") @db.Decimal(4, 2)
  tournamentMetricMannerScore      Decimal? @map("tournament_metric_manner_score") @db.Decimal(4, 2)
  tournamentMetricReviewCount      Int      @default(0) @map("tournament_metric_review_count")
  calculatedAt          DateTime?    @map("calculated_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  team V1Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([trustState])
  @@map("v1_team_trust_scores")
}

model V1PostEventReview {
  id             String                      @id @default(uuid())
  reviewerUserId String                      @map("reviewer_user_id")
  reviewerTeamId String?                     @map("reviewer_team_id")
  sourceType     V1PostEventReviewSourceType @map("source_type")
  sourceId       String                      @map("source_id")
  sourceGroupId  String?                     @map("source_group_id")
  targetType     V1PostEventReviewTargetType @map("target_type")
  targetUserId   String?                     @map("target_user_id")
  targetTeamId   String?                     @map("target_team_id")
  rating         Int
  sportId        String?                     @map("sport_id")
  status         V1PostEventReviewStatus     @default(submitted)
  submittedAt    DateTime                    @default(now()) @map("submitted_at")
  hiddenAt       DateTime?                   @map("hidden_at")
  removedAt      DateTime?                   @map("removed_at")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")
  // 이 후기가 어느 채점 체계로 제출됐는지. 기존 행은 전부 legacy_single_rating 이고,
  // 4항목 전환 이후 제출분만 four_metric 이다 — 두 세대를 섞어 평균 내지 않기 위한 구분자다.
  scoringVersion V1PostEventReviewScoringVersion @default(legacy_single_rating) @map("scoring_version")

  reviewerUser V1User                 @relation("V1PostEventReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  reviewerTeam V1Team?                @relation("V1PostEventReviewReviewerTeam", fields: [reviewerTeamId], references: [id], onDelete: Restrict)
  targetUser   V1User?                @relation("V1PostEventReviewTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetTeam   V1Team?                @relation("V1PostEventReviewTargetTeam", fields: [targetTeamId], references: [id], onDelete: Restrict)
  tags         V1PostEventReviewTag[]
  metricScores V1PostEventReviewMetricScore[]
  riskFlags    V1PostEventReviewRiskFlag[]

  @@unique([reviewerUserId, targetUserId, sourceType, sourceId])
  // 개인 대상 후기 중 대회(tournament_fixture) 후기는 중복 방지 스코프가 경기가 아니라 **대회**다 —
  // sourceId는 픽스처라서 위 제약만으로는 같은 상대를 예선·8강·결승에서 세 번 평가할 수 있다.
  // 팀 대상 후기의 sourceGroupId 제약과 같은 규칙이며, match 후기는 sourceGroupId가 NULL이라
  // (Postgres unique는 NULL을 서로 다른 값으로 본다) 이 제약에 걸리지 않는다.
  @@unique([reviewerUserId, targetUserId, sourceType, sourceGroupId], map: "v1_post_event_reviews_user_user_source_group_key")
  // 팀 대상 후기의 중복 방지 단위는 "팀"이 아니라 "사람"이다 — 참가팀 active 멤버 전원이
  // 상대팀 후기를 쓰므로, reviewerTeamId 기준으로 잠그면 팀에서 한 명만 쓰고 나머지가 막힌다.
  // 중복 스코프(team_match=매치당 sourceId / tournament_fixture=대회당 sourceGroupId)는 그대로 유지.
  @@unique([reviewerUserId, targetTeamId, sourceType, sourceId], map: "v1_post_event_reviews_user_team_source_key")
  @@unique([reviewerUserId, targetTeamId, sourceType, sourceGroupId], map: "v1_post_event_reviews_user_team_source_group_key")
  @@index([reviewerUserId, sourceType, submittedAt])
  @@index([reviewerTeamId, sourceType, submittedAt])
  @@index([targetUserId, submittedAt])
  @@index([targetTeamId, submittedAt])
  @@index([sourceType, sourceId])
  @@index([sourceType, sourceGroupId])
  @@index([targetType])
  @@index([status])
  @@index([targetUserId, sportId, submittedAt], map: "v1_post_event_reviews_target_user_sport_idx")
  @@index([targetTeamId, sportId, submittedAt], map: "v1_post_event_reviews_target_team_sport_idx")
  @@map("v1_post_event_reviews")
}

model V1PostEventReviewTag {
  id            String   @id @default(uuid())
  reviewId      String   @map("review_id")
  tagCode       String   @map("tag_code")
  labelSnapshot String   @map("label_snapshot")
  createdAt     DateTime @default(now()) @map("created_at")

  review V1PostEventReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, tagCode])
  @@index([tagCode])
  @@map("v1_post_event_review_tags")
}

model V1PostEventReviewMetricScore {
  id       String                  @id @default(uuid())
  reviewId String                  @map("review_id")
  metric   V1PostEventReviewMetric
  score    Int

  review V1PostEventReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, metric])
  @@map("v1_post_event_review_metric_scores")
}

model V1PostEventReviewRiskFlag {
  id               String                          @id @default(uuid())
  // 같은 판정 묶음(경기 × 규칙 등)을 운영자가 한 번에 처리하기 위한 키. 운영 큐가 이 단위로 resolve 한다.
  groupKey         String                          @map("group_key")
  reviewId         String                          @map("review_id")
  ruleCode         V1PostEventReviewRiskRule       @map("rule_code")
  riskScore        Int                             @map("risk_score")
  signal           Json
  status           V1PostEventReviewRiskFlagStatus @default(pending)
  resolvedByUserId String?                         @map("resolved_by_user_id")
  resolvedAt       DateTime?                       @map("resolved_at")
  createdAt        DateTime                        @default(now()) @map("created_at")

  review V1PostEventReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, ruleCode])
  @@index([status, createdAt])
  @@index([groupKey])
  @@map("v1_post_event_review_risk_flags")
}

model V1TeamMatch {
  id                         String            @id @default(uuid())
  hostTeamId                 String            @map("host_team_id")
  createdByUserId            String            @map("created_by_user_id")
  sportId                    String            @map("sport_id")
  regionId                   String            @map("region_id")
  title                      String
  description                String?
  imageUrl                   String?           @map("image_url")
  placeName                  String            @map("place_name")
  placeAddress               String?           @map("place_address")
  startAt                    DateTime          @map("start_at")
  endAt                      DateTime?         @map("end_at")
  deadlineAt                 DateTime?         @map("deadline_at")
  formatNote                 String?           @map("format_note")
  matchFormat                String?           @map("match_format")
  matchStyle                 String[]          @default([]) @map("match_style")
  uniformColor               String?           @map("uniform_color")
  minSportLevelId            String?           @map("min_sport_level_id")
  maxSportLevelId            String?           @map("max_sport_level_id")
  genderRule                 String?           @map("gender_rule")
  costNote                   String?           @map("cost_note")
  status                     V1TeamMatchStatus @default(recruiting)
  approvedApplicantTeamId    String?           @map("approved_applicant_team_id")
  cancelledAt                DateTime?         @map("cancelled_at")
  completedAt                DateTime?         @map("completed_at")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")
  deletedAt                  DateTime?         @map("deleted_at")
  // Nullable / no default until the deferred contract-phase migration adds
  // SET NOT NULL + SET DEFAULT — see
  // docs/ops/task9-competition-config-contract-phase.md. The FK constraint
  // itself (v1_team_matches_competition_config_fk) already exists (added by
  // 20260729000100_v1_game_operations while this column was still nullable
  // there too), so `competitionConfig` stays a real relation, just optional.
  competitionConfigVersionId String?           @map("competition_config_version_id")
  // 소속 리그(일반 리그, 대회와 무관). null 이면 단발 팀 매치다.
  // 2026-08-18 재명명의 확장-수축이 여기서 끝났다 -- 구 seriesId 컬럼과
  // v1_team_match_series* 는 수축 릴리스에서 제거됐다.
  leagueId                   String?           @map("league_id")

  hostTeam              V1Team                      @relation("V1HostTeamMatches", fields: [hostTeamId], references: [id], onDelete: Restrict)
  createdByUser         V1User                      @relation("V1TeamMatchCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sport                 V1Sport                     @relation(fields: [sportId], references: [id], onDelete: Restrict)
  minSportLevel         V1SportLevel?               @relation("V1TeamMatchMinSportLevel", fields: [minSportLevelId], references: [id], onDelete: SetNull)
  maxSportLevel         V1SportLevel?               @relation("V1TeamMatchMaxSportLevel", fields: [maxSportLevelId], references: [id], onDelete: SetNull)
  region                V1Region                    @relation(fields: [regionId], references: [id], onDelete: Restrict)
  approvedApplicantTeam V1Team?                     @relation("V1ApprovedApplicantTeam", fields: [approvedApplicantTeamId], references: [id], onDelete: SetNull)
  applications          V1TeamMatchApplication[]
  chatRoom              V1ChatRoom?
  game                  V1Game?                     @relation("V1GameTeamMatch")
  videos                V1TeamMatchVideo[]
  competitionConfig     V1CompetitionConfigVersion? @relation("V1TeamMatchCompetitionConfig", fields: [competitionConfigVersionId], references: [id], onDelete: Restrict, map: "v1_team_matches_competition_config_fk")
  /// BE-5 drop: 리그는 통합 축이 정본이라 이 FK 도 `V1Tournament` 를 가리킨다(id 는 두 축이
  /// 같아서 컬럼 값은 그대로다). 리그가 지워져도 대진은 남아야 하므로 SET NULL 유지.
  league                V1Tournament?               @relation("V1TeamMatchLeague", fields: [leagueId], references: [id], onDelete: SetNull, map: "v1_team_matches_league_fk")

  @@index([hostTeamId])
  @@index([createdByUserId])
  @@index([sportId, regionId, status, startAt])
  @@index([minSportLevelId])
  @@index([maxSportLevelId])
  @@index([approvedApplicantTeamId])
  @@index([status])
  @@index([startAt])
  @@index([createdAt])
  @@index([competitionConfigVersionId], map: "v1_team_matches_competition_config_idx")
  @@index([leagueId, startAt], map: "v1_team_matches_league_start_at_idx")
  @@map("v1_team_matches")
}

/// 리그 대진(팀매치) 하이라이트/중계 영상 — 경기당 여러 개 (유튜브 링크 또는 업로드 파일 URL).
/// V1TournamentFixtureVideo 의 팀매치 판 — 같은 URL 검증·업로드 원장 규칙을 공유한다
/// (apps/v1_api/src/tournaments/videos/fixture-video-url.ts).
model V1TeamMatchVideo {
  id          String   @id @default(uuid())
  teamMatchId String   @map("team_match_id")
  /// 표시 제목 (예: "전반 하이라이트") — 없으면 "경기 영상 N"으로 표시
  title       String?
  url         String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  teamMatch V1TeamMatch @relation(fields: [teamMatchId], references: [id], onDelete: Cascade)

  @@index([teamMatchId, sortOrder])
  @@map("v1_team_match_videos")
}

model V1TeamMatchApplication {
  id               String                       @id @default(uuid())
  teamMatchId      String                       @map("team_match_id")
  applicantTeamId  String                       @map("applicant_team_id")
  appliedByUserId  String                       @map("applied_by_user_id")
  status           V1TeamMatchApplicationStatus @default(requested)
  message          String?
  reviewedByUserId String?                      @map("reviewed_by_user_id")
  reviewedAt       DateTime?                    @map("reviewed_at")
  withdrawnAt      DateTime?                    @map("withdrawn_at")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  teamMatch      V1TeamMatch @relation(fields: [teamMatchId], references: [id], onDelete: Cascade)
  applicantTeam  V1Team      @relation("V1TeamMatchApplicantTeam", fields: [applicantTeamId], references: [id], onDelete: Restrict)
  appliedByUser  V1User      @relation("V1TeamMatchApplicantUser", fields: [appliedByUserId], references: [id], onDelete: Restrict)
  reviewedByUser V1User?     @relation("V1TeamMatchReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([teamMatchId, applicantTeamId])
  @@index([applicantTeamId, status])
  @@index([appliedByUserId])
  @@index([status])
  @@index([createdAt])
  @@map("v1_team_match_applications")
}

// ── 일반 리그(League) — 대회(Tournament)와는 별개 도메인 ──────────────────────
// 팀 매치 여러 개를 묶는 컨테이너다. 개별 경기는 V1TeamMatch 그대로이고,
// leagueId 가 채워진 경기가 "리그전"으로 표시된다.
// 사용자 화면 문구는 이 재명명 이전부터 이미 "리그"였다 -- 재명명은 코드/DB 이름을
// 그 문구에 맞춘 작업이었다(확장-수축 2단계, 2026-08-18~19).
//
// Task 153 부터 V1League 는 두 가지로 쓰인다:
//   (a) seriesId = null  → 종래의 단발 리그. tier·seasonNo 도 함께 null 이다
//                          (티어가 "1부"인 게 아니라 티어 개념 자체가 없다).
//   (b) seriesId != null → 리그 체계(V1LeagueSeries)의 "N시즌 x T티어" 인스턴스.
//                          시즌 종료 시 순위표 기반으로 승격·강등이 계산된다.
// (a) 를 (b) 로 강제 이관하지 않는다 — 기존 리그는 그대로 동작해야 한다.

// ── 리그 체계(Series) — 티어(1부/2부/3부) + 시즌 + 승강 ────────────────────────
// 하나의 시리즈가 (종목 x 지역)의 리그 체계 하나를 뜻한다. 시리즈 아래에
// 시즌(seasonNo) x 티어(tier) 조합마다 V1League 인스턴스가 하나씩 생긴다.
// 티어 1 이 최상위(사용자 화면 문구로는 "1부")다.

enum V1LeagueSeriesState {
  draft
  active
  archived
}

model V1LeagueSeries {
  id                   String              @id @default(uuid())
  title                String
  sportId              String              @map("sport_id")
  regionId             String              @map("region_id")
  createdByAdminUserId String              @map("created_by_admin_user_id")
  // 1~3. 종목·지역에 따라 팀이 모이지 않으면 1티어로만 운영한다 —
  // 티어를 억지로 3개로 쪼개면 빈 껍데기 리그가 생긴다.
  tierCount            Int                 @default(1) @map("tier_count")
  // 승강 규칙은 코드가 아니라 어드민이 정한다. 스키마는
  // apps/v1_api/src/league-matches/league-promotion.ts 의 PromotionRule 을 따른다.
  promotionRuleJson    Json                @map("promotion_rule_json")
  state                V1LeagueSeriesState @default(draft)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  sport          V1Sport     @relation("V1LeagueSeriesSport", fields: [sportId], references: [id], onDelete: Restrict, map: "v1_league_series_sport_fk")
  region         V1Region    @relation("V1LeagueSeriesRegion", fields: [regionId], references: [id], onDelete: Restrict, map: "v1_league_series_region_fk")
  createdByAdmin V1AdminUser @relation("V1LeagueSeriesAdmin", fields: [createdByAdminUserId], references: [id], onDelete: Restrict, map: "v1_league_series_admin_fk")
  // R1 expand: 통합 후 시즌은 V1Tournament(kind=regular_league) 행이 된다. 아직 이 배열에
  // 담기는 행은 없고(백필은 R3), 시리즈 테이블 자체의 컬럼은 바뀌지 않는다 — 역참조뿐이다.
  tournaments    V1Tournament[] @relation("V1TournamentSeries")

  @@index([sportId, regionId, state])
  @@map("v1_league_series")
}

enum V1LeaguePromotionKind {
  promoted
  relegated
  stayed
  withdrawn
}

// 승강 확정 이력. 어드민이 최종 승인한 시점에만 행이 생긴다(preview 단계에서는 쓰지 않는다).
// computedKind 는 규칙이 계산한 원래 값이고 kind 는 어드민이 최종 승인한 값이다 —
// 둘이 다르면 사람이 개입한 것이고, 그 사유가 overrideNote 에 남는다.
model V1LeaguePromotion {
  id                   String                @id @default(uuid())
  fromLeagueId         String                @map("from_league_id")
  teamId               String                @map("team_id")
  fromTier             Int                   @map("from_tier")
  toTier               Int                   @map("to_tier")
  kind                 V1LeaguePromotionKind
  computedKind         V1LeaguePromotionKind @map("computed_kind")
  overriddenByAdmin    Boolean               @default(false) @map("overridden_by_admin")
  overrideNote         String?               @map("override_note")
  decidedByAdminUserId String                @map("decided_by_admin_user_id")
  decidedAt            DateTime              @default(now()) @map("decided_at")

  /// BE-5 drop — 위 대진과 같은 이유. 승강 기록은 그 리그에 종속이라 CASCADE 유지.
  fromLeague     V1Tournament @relation("V1LeaguePromotionFromLeague", fields: [fromLeagueId], references: [id], onDelete: Cascade, map: "v1_league_promotions_league_fk")
  team           V1Team      @relation("V1LeaguePromotionTeam", fields: [teamId], references: [id], onDelete: Restrict, map: "v1_league_promotions_team_fk")
  decidedByAdmin V1AdminUser @relation("V1LeaguePromotionAdmin", fields: [decidedByAdminUserId], references: [id], onDelete: Restrict, map: "v1_league_promotions_admin_fk")

  // 한 시즌의 한 팀에 대한 승강 결정은 하나뿐이다 — 중복 확정을 DB 레벨에서 막는다.
  @@unique([fromLeagueId, teamId], map: "v1_league_promotions_league_team_key")
  @@index([teamId])
  @@map("v1_league_promotions")
}

enum V1LeagueMatchDisputeStatus {
  open
  accepted
  rejected
}

enum V1LeagueMatchDisputeResolution {
  correction
  void
}

// D2: 리그 경기 결과 확정 후 7일 이내 이의 제기(E2/E4). 신뢰 무결성보다 최소
// 풋프린트를 택해 아래 참조 컬럼은 전부 FK 관계를 걸지 않은 평문 문자열이다 --
// `V1OperationAudit`/`V1StatusChangeLog`가 actor 참조에 이미 쓰는 것과 같은
// 감사원장 스타일이며(스키마 전체를 결속하는 게임 소스 스냅샷 가드 아래에서
// 다른 5개 모델의 역참조 배열을 건드리지 않는 순수 CREATE TABLE로 남는다),
// 조회는 인덱스 컬럼으로 충분하고(운영 알림도 이미 이 파일 옆
// `game-result-submitted-escalation.service.ts`가 raw SQL join으로 하는 방식이다).
model V1LeagueMatchDispute {
  id                     String                          @id @default(uuid())
  leagueId               String                          @map("league_id")
  teamMatchId            String                          @map("team_match_id")
  // 이의를 제기한 시점에 걸려 있던 공식 리비전 — **감사 기록 전용이다.**
  // 해결 로직은 이 값을 읽지 않고 그 시점의 game.currentOfficialRevisionId 를 대상으로
  // 동작한다. 대상이 "지금 공식인 결과" 하나뿐이라 stale 판정이 필요 없기 때문이다:
  // 이의가 열린 사이 다른 정정이 들어왔다면 운영자가 보는 것도 그 새 결과이고,
  // 그것을 다시 정정·무효하는 것이 옳다. (초기 주석이 존재하지 않는 stale 검사를
  // 설명하고 있어 바로잡음 — 적대 리뷰 지적)
  resultRevisionId       String                          @map("result_revision_id")
  raisedByUserId         String                          @map("raised_by_user_id")
  raisedByTeamId         String                          @map("raised_by_team_id")
  reason                 String
  status                 V1LeagueMatchDisputeStatus       @default(open)
  resolution             V1LeagueMatchDisputeResolution?
