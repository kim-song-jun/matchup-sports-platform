enum V1PushPlatform {
  android
  ios
}

enum V1PushEnvironment {
  alpha
  production
}

/// Which APNs gateway a device's token was issued by.
///
/// Deliberately separate from V1PushEnvironment, which says *which deployment* a device
/// belongs to. The two used to coincide — an alpha build was only ever installed from Xcode,
/// and that is always a development signature — but TestFlight is signed for production, so
/// an alpha device can now legitimately hold a production token. Sending it to the sandbox
/// gateway returns BadDeviceToken, which the send path treats as permanent and revokes the
/// registration outright.
enum V1ApnsEnvironment {
  sandbox
  production
}

model V1PushDevice {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  installationId String            @map("installation_id")
  platform       V1PushPlatform
  environment    V1PushEnvironment
  /// Which APNs gateway issued this token. Null for Android, which has no such axis, and for
  /// iOS registrations made before the app reported it — those fall back to the server's own
  /// environment, which is exactly the behaviour they had.
  apnsEnvironment V1ApnsEnvironment? @map("apns_environment")
  token          String            @unique
  appVersion     String?           @map("app_version")
  deviceModel    String?           @map("device_model")
  lastSeenAt     DateTime          @default(now()) @map("last_seen_at")
  revokedAt      DateTime?         @map("revoked_at")
  failureCount   Int               @default(0) @map("failure_count")
  lastSuccessAt  DateTime?         @map("last_success_at")
  lastFailureAt  DateTime?         @map("last_failure_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user V1User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([environment, installationId])
  @@index([userId, environment, revokedAt])
  @@map("v1_push_devices")
}

model V1WebPushFailureLog {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  subscriptionId String?   @map("subscription_id")
  statusCode     Int?      @map("status_code")
  errorCode      String?   @map("error_code")
  endpointSuffix String    @map("endpoint_suffix")
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by")

  user               V1User              @relation("V1WebPushFailureLogUser", fields: [userId], references: [id], onDelete: Cascade)
  subscription       V1PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  acknowledgedByUser V1User?             @relation("V1WebPushFailureLogAcknowledgedBy", fields: [acknowledgedBy], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([acknowledgedAt])
  @@index([userId])
  @@index([subscriptionId])
  @@map("v1_web_push_failure_logs")
}

/// SMS 발송 / 휴대폰·이메일 인증 실패 이벤트 로그(V1WebPushFailureLog 미러).
/// 실패·이슈만 기록하고 성공 이벤트는 남기지 않는다 — 운영자가 "지금 무엇이 깨졌나"만
/// 보면 되고, 성공까지 적재하면 유료 SMS 트래픽 전량이 그대로 테이블이 되기 때문이다.
/// 가입 전(pre-account) 인증에도 쓰이므로 userId 관계가 없고, 식별자는 번호 끝 4자리
/// (phoneMasked)만 저장해 원본 번호가 어드민 표면에 도달하지 않게 한다.
model V1SmsEventLog {
  id             String    @id @default(uuid())
  eventType      String    @map("event_type")
  resultCode     String?   @map("result_code")
  phoneMasked    String    @map("phone_masked")
  provider       String?
  detail         String?
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([acknowledgedAt])
  @@map("v1_sms_event_logs")
}

/// 서버(AllExceptionsFilter)·클라이언트(POST /logs/client-error) 에러를 어드민에서
/// 조사할 수 있도록 적재하는 로그. 창(window) 버킷으로 같은 에러를 한 행에 접어
/// occurrenceCount 로 누적한다 — 정상 흐름 전수 적재라 dedupe 없이는 목록이 즉시 뒤덮인다.
/// statusCode 401/403 은 24시간 창, 그 외는 1시간 창을 쓴다(ErrorLogService 참조).
/// 보존 기한 없음(무기한) — 마스킹(mask-sensitive.ts)이 유일한 방어선이므로 신규 필드
/// 추가 시 반드시 민감정보 목록을 함께 점검한다.
model V1ErrorLog {
  id              String   @id @default(uuid())
  fingerprint     String
  windowBucket    DateTime @map("window_bucket")
  occurrenceCount Int      @default(1) @map("occurrence_count")

  source     String
  level      String
  statusCode Int?    @map("status_code")
  errorCode  String? @map("error_code")
  method     String?
  route      String?
  message    String
  stack      String?

  requestBody    Json? @map("request_body")
  requestHeaders Json? @map("request_headers")
  responseBody   Json? @map("response_body")
  context        Json?

  userId     String? @map("user_id")
  userAgent  String? @map("user_agent")
  releaseSha String? @map("release_sha")

  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  @@unique([fingerprint, windowBucket])
  @@index([lastSeenAt])
  @@index([source, statusCode])
  @@map("v1_error_logs")
}

