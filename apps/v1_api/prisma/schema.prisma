model V1TournamentFixture {
  id                         String                    @id @default(uuid())
  tournamentId               String                    @map("tournament_id")
  groupId                    String?                   @map("group_id")
  round                      String
  fixtureNumber              Int                       @map("fixture_number")
  legNumber                  Int                       @default(1) @map("leg_number")
  parentFixtureId            String?                   @map("parent_fixture_id")
  homeRegistrationId         String?                   @map("home_registration_id")
  awayRegistrationId         String?                   @map("away_registration_id")
  scheduledAt                DateTime?                 @map("scheduled_at")
  fieldId                    String?                   @map("field_id")
  venue                      String?
  status                     V1TournamentFixtureStatus @default(scheduled)
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  // Nullable / no default until the deferred contract-phase migration adds
  // SET NOT NULL + SET DEFAULT — see
  // docs/ops/task9-competition-config-contract-phase.md. The FK constraint
  // itself (v1_tournament_fixtures_competition_config_fk) already exists
  // (added by 20260729000100_v1_game_operations while this column was still
  // nullable there too), so `competitionConfig` stays a real relation, just
  // optional.
  competitionConfigVersionId String?                   @map("competition_config_version_id")

  tournament         V1Tournament                         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group              V1TournamentGroup?                   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  parentFixture      V1TournamentFixture?                 @relation("V1TournamentFixtureParent", fields: [parentFixtureId], references: [id], onDelete: SetNull)
  childFixtures      V1TournamentFixture[]                @relation("V1TournamentFixtureParent")
  homeRegistration   V1TournamentRegistration?            @relation("V1TournamentFixtureHome", fields: [homeRegistrationId], references: [id], onDelete: SetNull)
  awayRegistration   V1TournamentRegistration?            @relation("V1TournamentFixtureAway", fields: [awayRegistrationId], references: [id], onDelete: SetNull)
  result             V1TournamentFixtureResult?
  videos             V1TournamentFixtureVideo[]
  game               V1Game?                              @relation("V1GameTournamentFixture")
  competitionConfig  V1CompetitionConfigVersion?          @relation("V1FixtureCompetitionConfig", fields: [competitionConfigVersionId], references: [id], onDelete: Restrict, map: "v1_tournament_fixtures_competition_config_fk")
  field              V1TournamentField?                   @relation(fields: [tournamentId, fieldId], references: [tournamentId, id], onDelete: Restrict, map: "v1_tournament_fixtures_field_fk")
  staffScopes        V1TournamentStaffFixtureScope[]
  operationAudits    V1OperationAudit[]
  advancementSources V1TournamentFixtureAdvancementEdge[] @relation("V1FixtureAdvancementSource")
  advancementTargets V1TournamentFixtureAdvancementEdge[] @relation("V1FixtureAdvancementTarget")

  @@unique([tournamentId, id], map: "v1_tournament_fixtures_tournament_id_id_key")
  @@unique([tournamentId, round, fixtureNumber, legNumber], map: "v1_tournament_fixtures_tournament_round_number_leg_key")
  @@index([tournamentId, round, fixtureNumber])
  @@index([groupId])
  @@index([parentFixtureId])
  @@index([competitionConfigVersionId], map: "v1_tournament_fixtures_competition_config_idx")
  @@index([status, id], map: "v1_tournament_fixtures_status_id_backfill_idx")
  @@map("v1_tournament_fixtures")
}

