FROM node:22-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46

ENV CI=1 \
    TZ=UTC \
    LANG=C.UTF-8 \
    PNPM_HOME=/verification/cache/pnpm \
    HOME=/verification/cache/home \
    PATH=/verification/cache/pnpm:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN corepack enable \
    && corepack prepare pnpm@9.15.4 --activate \
    && apt-get update \
    && apt-get install --yes --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 verification \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /verification/cache/home verification \
    && mkdir -p /verification/source /verification/cache /verification/receipts /verification/bound \
    && chown -R 10001:10001 /verification

WORKDIR /verification/source
USER 10001:10001

ENTRYPOINT []
CMD ["node", "--version"]
