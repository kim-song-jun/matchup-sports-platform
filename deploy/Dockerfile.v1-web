# syntax=docker/dockerfile:1

FROM node:22-alpine AS base

# The mutable Node Alpine base can lag behind Alpine security repository updates.
# Refresh the runtime OpenSSL libraries so ECR does not ship known critical CVEs.
RUN apk upgrade --no-cache libcrypto3 libssl3

FROM base AS builder
WORKDIR /app
RUN npm install -g pnpm@9.15.4

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/v1_web/package.json apps/v1_web/
RUN --mount=type=cache,id=teameet-pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked \
  pnpm install --frozen-lockfile

COPY apps/v1_web/ apps/v1_web/

ARG NEXT_PUBLIC_API_URL=/api/v1
ARG INTERNAL_API_ORIGIN=http://v1_api:8121
ARG NEXT_PUBLIC_KAKAO_CLIENT_ID=
ARG NEXT_PUBLIC_KAKAO_REDIRECT_URI=
# 카카오 추가 동의항목(이름/전화번호/성별) 요청용. 콘솔에서 승인된 항목만 넣어야 하며,
# 미승인 scope 를 요청하면 authorize 단계에서 로그인이 실패한다. 비워 두면 요청하지 않는다.
ARG NEXT_PUBLIC_KAKAO_SCOPE=
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID=
# 검색엔진(네이버·구글·빙) 소유확인 코드(HTML 에 공개되는 값, 비밀 아님). 정적 프리렌더 페이지는
# 빌드 때 굽고 동적 페이지는 런타임에 읽으므로 runtime 스테이지에도 같은 값을 넘긴다.
ARG NAVER_SITE_VERIFICATION=
ARG GOOGLE_SITE_VERIFICATION=
ARG BING_SITE_VERIFICATION=
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV INTERNAL_API_ORIGIN=${INTERNAL_API_ORIGIN}
ENV NEXT_PUBLIC_KAKAO_CLIENT_ID=${NEXT_PUBLIC_KAKAO_CLIENT_ID}
ENV NEXT_PUBLIC_KAKAO_REDIRECT_URI=${NEXT_PUBLIC_KAKAO_REDIRECT_URI}
ENV NEXT_PUBLIC_KAKAO_SCOPE=${NEXT_PUBLIC_KAKAO_SCOPE}
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=${NEXT_PUBLIC_GA_MEASUREMENT_ID}
ENV NAVER_SITE_VERIFICATION=${NAVER_SITE_VERIFICATION}
ENV GOOGLE_SITE_VERIFICATION=${GOOGLE_SITE_VERIFICATION}
ENV BING_SITE_VERIFICATION=${BING_SITE_VERIFICATION}
ENV NODE_ENV=production

WORKDIR /app/apps/v1_web
RUN --mount=type=cache,id=teameet-v1-web-next-cache,target=/app/apps/v1_web/.next/cache,sharing=locked \
  npx next build

FROM base AS runtime
WORKDIR /app

# The runtime starts the standalone Next.js server with node. Remove the
# bundled npm/npx tree because npm 10.9.8 contains tar 7.5.11
# (CVE-2026-59873); neither command is needed after the builder stage. Alpine
# OpenSSL 3.5.8 also removes the runtime CVE-2026-63073 finding.
RUN apk upgrade --no-cache libcrypto3 libssl3 \
  && rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx

COPY --from=builder /app/apps/v1_web/.next/standalone ./
COPY --from=builder /app/apps/v1_web/.next/static ./apps/v1_web/.next/static
COPY --from=builder /app/apps/v1_web/public ./apps/v1_web/public

ARG NAVER_SITE_VERIFICATION=
ARG GOOGLE_SITE_VERIFICATION=
ARG BING_SITE_VERIFICATION=
ENV NAVER_SITE_VERIFICATION=${NAVER_SITE_VERIFICATION}
ENV GOOGLE_SITE_VERIFICATION=${GOOGLE_SITE_VERIFICATION}
ENV BING_SITE_VERIFICATION=${BING_SITE_VERIFICATION}
ENV NODE_ENV=production
ENV PORT=3013
ENV HOSTNAME=0.0.0.0
EXPOSE 3013

# 고정 UID/GID(1001) — v1-api와 동일 정책.
RUN addgroup -S -g 1001 app && adduser -S -u 1001 -G app app \
  && chown -R app:app /app

USER app
CMD ["node", "apps/v1_web/server.js"]
