[Unit]
Description=Restart Teameet app containers that stay unhealthy
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/teameet-restart-unhealthy.sh
RuntimeDirectory=teameet-restart-unhealthy
# 재시작 기록이 타이머 실행 사이에 남아야 쿨다운이 동작한다.
RuntimeDirectoryPreserve=yes
# docker restart 가 컨테이너 종료 여유(stop_grace_period 최대 60초)를 기다릴 수 있다.
TimeoutStartSec=300
Nice=10
